//! member: false
//! dialog's tets: keys in, text and answers out. No terminal.

use dialog
use keys

fn press(mut d: dialog.Dialog, code: int, mods: int) -> int {
	dialog.key(mut d, keys.Key { code: code, mods: mods })
}

fn typed(mut d: dialog.Dialog, text: str) {
	for ch in text.chars() {
		let _ = press(mut d, ch as int, 0)
	}
}

fn test_typing_and_moving() {
	var d = dialog.closed()

	dialog.edit(mut d, 7, "Name:", "")
	typed(mut d, "abc")

	let _ = press(mut d, keys.K_LEFT, 0)
	typed(mut d, "X")

	assert(dialog.text_of(d) == "abXc", "insert in the middle: {dialog.text_of(d)}")
	assert(d.at == 3, "curstor after X: {d.at}")

	let _ = press(mut d, keys.K_BACKSPACE, 0)

	assert(dialog.text_of(d) == "abc", "backspace: {dialog.text_of(d)}")

	let _ = press(mut d, keys.K_HOME, 0)
	let _ = press(mut d, keys.K_DEL, 0)

	assert(dialog.text_of(d) == "bc" && d.at == 0, "home, delete: {dialog.text_of(d)}")

	let _ = press(mut d, keys.K_END, 0)

	assert(d.at == 2, "end")
	assert(press(mut d, keys.K_ENTER, 0) == dialog.ACCEPT, "enter accepts")
	assert(d.action == 7, "the action rides along")
}

fn test_initial_text_and_unicode() {
	var d = dialog.closed()
	dialog.edit(mut d, 1, "Rename to:", "cafe")

	assert(d.at == 4, "cursor at the end of four code points: {d.at}")

	typed(mut d, "s")

	assert(dialog.text_of(d) == "cafes", "after typing: {dialog.text_of(d)}")

	let _ = press(mut d, keys.K_LEFT, 0)
	let _ = press(mut d, keys.K_BACKSPACE, 0)

	assert(dialog.text_of(*d) == "cafs", "deleted the e: {dialog.text_of(d)}")
	assert(dialog.slice(d, 1, 3) == "af", "slice")
}

fn test_controls_are_not_typed() {
	var d = dialog.closed()
	dialog.edit(mut d, 1, "x", "one")

	let _ = press(mut d, 120, keys.MOD_CTRL)
	let _ = press(mut d, 120, keys.MOD_ALT)
	let _ = press(mut d, keys.K_F0 + 5, 0)

	assert(dialog.text_of(d) == "one", "nothing typed: {dialog.text_of(d)}")

	let _ = press(mut d, 117, keys.MOD_CTRL)

	assert(dialog.text_of(d) == "" && d.at == 0, "Ctrl-U clears before the cursor")
	assert(press(mut d, keys.K_ESC, 0) == dialog.CANCEL, "escape cancels") 
}

fn test_questions() {
	var d = dialog.closed()
	dialog.ask(mut d, 3, "Delete 2 items? (y/N)")

	assert(dialog.title_of(d) == "Delete 2 items? (y/N)", "title")
	assert(press(mut d, 121, 0) == dialog.ACCEPT, "y is yes")
	assert(press(mut d, 89, 0) == dialog. ACCEPT, "Y is yes")
	assert(press(mut d, 110, 0) == dialog.CANCEL, "n is no")
	assert(press(mut d, keys.K_ENTER, 0) == dialog.CANCEL, "Enter is no: the default is no")
	assert(press(mut d, 121, keys.MOD_CTRL) == dialog.CANCEL, "Ctrl-Y is not yes")
}

fn test_utf8_encoding() {
	var b = List[byte]()
	dialog.push_utf8(mut b, 65)
	dialog.push_utf8(mut b, 233)
	dialog.push_utf8(mut b, 9472)
	dialog.push_utf8(mut b, 128058)

	assert(b.len == 1 + 2+ 3 + 4, "lengths {b.len}")
}








