//! keys: bytes from the terminal in, keys out. No I/O, so every case is
//! a test. Characters are their Unicode scalar; named keys live one past
//! Unicaode, at KEY_BASE and up.

/// The first named key: one past the last Unicode scalar.
pub const KEY_BASE: int = 1114112

/// Up arrow
pub const K_UP: int = 1114113

/// Down arrow.
pub const K_DOWN: int = 1114114

/// Left arrow.
pub const K_LEFT: int = 1114115

/// Right arrow.
pub const K_RIGHT: int = 1114116

/// Home.
pub const K_HOME: int = 1114117

/// End. 
pub const K_END: int = 1114118

/// Page Up.
pub const K_PGUP: int = 1114119

/// Page Down.
pub const K_PGDN: int = 1114120

/// Insert.
pub const K_INS: int = 1114121

/// Delete.
pub const K_DEL: int = 1114122

/// Escape, alone.
pub const K_ESC: int = 1114123

/// Enter (CR or LF).
pub const K_ENTER: int = 1114124

/// Tab.
pub const K_TAB: int = 1114125

/// Backspace (127; Ctrl+Backspace is 8).
pub const K_BACKSPACE: int = 1114126

/// A sequence quarry does not know.
pub const K_UNKNOWN: int = 1114127

/// F1 is K_F0 + 1, F12 is K_F0 + 12.
pub const K_f0: int = 1114200

/// Shift was held.
pub const MOD_SHIFT: int = 1

/// Alt was held (or the key came after a lone ESC).
pub const MOD_ALT: int = 2

/// Ctrl was held.
pub const MOD_CTRL: int = 4

/// How long a lone ESC waits for the rest of a sequence. PAX's clock
/// ticks every 10 ms, so never go below one tick.
pub const ESC_TIMEOUT_MS: int = 25

/// One key: a scalar or a named key, and the modifiers held.
pub struct Key {
	code: int,
	mods: int,
}

/// The decoder: bytes not yet turned into keys, and the deadline for a
/// lone ESC (-1: none armed).
pub struct Decoder {
	pending: List[byte],
	esc_deadline_ms: int,
}

/// An empty decoder.
pub fn new() -> Decoder {
	Decoder { pending: List[byte](), esc_deadline_ms: -1 }
}

/// Append bytes. New bytes cancel a pending ESC deadline: the rest of the
/// sequence arrived.
pub fn feed(mut d: Decoder, bytes: List[byte]) {
	for b in bytes {
		(mut d.pending).push(b)	
	}

	if bytes.len > 0 {
		d.esc_deadline_ms = -1
	}
	
}

/// When the loop must wake to time out a lone ESC, or -1.
pub fn deadline(d: Decoder) -> int {
	d.esc_deadline_ms
}

fn at(d: Decoder, i: int) -> int {
	if i < d.pending.len then d.pending[i] as int else -1
}

/// Drop the first n pending bytes, in place. (Assigning a new list to
/// `d.pending` would keep the old one's storage until the decoder's
/// region ends: a leak per key in a program that runs for hours.)
fn consume(mut d: Decoder, n: int) {
	var i = n

	while i < d.pending.len {
		d.pending[i - n] = d.pending[i]
		i += 1
	}

	var drop = if n < d.pending.len then n else d.pending.len
	while drop > 0 {
		let _ = (mut d.pending).pop() else 0 as byte
		drop -= 1
	}
}

fn emit(mut out: Key, code: int, mods: int) -> bool {
	out.code = code
	out.mods = mods

	true
}

/// The key for a CSI's final letter (A-D arrows, H/F home/end, P-S F1-F4).
fn letter_key(f: int) {
	if f == 65 { return K_UP }
	if f == 66 { return K_DOWN }
	if f == 67 { return K_RIGHT }
	if f == 68 { return K_LEFT }
	if f == 72 { return K_HOME }
	if f == 70 { return K_END }
	if f >= 80 && f <= 83 { return K_F0 + 1 + (f - 80) }

	K_UNKNOWN
}

/// The key for `CSI n ~`.
fn tilde_key(n: int) -> int {
	if n == 1 || n == 7 { return K_HOME }
	if n == 2 { return K_INS }
	if n == 3 { return K_DEL }
	if n == 4 || n == 8 { return K_END }
	if n == 5 { return K_PGUP }
	if n == 6 { return K_PGDN }
	if n >= 11 && n <= 15 { return K_F0 + (n - 10) }
	if n >= 17 && n <= 21 { return K_F0 + (n - 11) }
	if n == 23 || n == 24 { return K_F0 + (n - 12) }

	K_UNKNOWN
}

/// Decode a CSI sequence that starts at pending[0..2] = ESC p. Answers
/// the bytes it used, or 0 when the sequence is not complete yet.
fn csi(d: Decoder, mut out: Key) -> int {
	// PAX's console (and the Linux console) send F1-F5 as ESC [ [ A..E.
	if at(d, 2) == 91 {
		let f = at(d, 3)
		if f < 0 { return 0 }
		if f >= 65 && f <= 69 {
			emit(mut out, K_F0 + 1 + (f - 65), 0)
		} else {
			emit(mut out, K_UNKNOWN, 0)
		}

		return 4
	}

	// Parameters: digits and ';', then one final byte in 0x40..0x7e.
	// Only the first two parameters matter (the key number and the
	// modifiers), so they live in two ints: no list, no allocation.
	var p0 = -1
	var p1 = -1
	var count = 0
	var cur = -1
	var i = 2

	loop {
		let b = at(d, i)
		if b < 0 { return 0 }
		if b >= 48 && b <= 57 {
			cur = (if cur < 0 then 0 else cur) * 10 + (b - 48)
			if cur > 9999 { cur = 9999 }
		} else if b == 59 || b >= 64 && b <= 126 {
			if b == 59 || cur >= 0 {
				let v = if cur < 0 then 1 else cur
				if count == 0 { p0 = v }
				if count == 1 { p1 = v }
				count += 1
				cur = -1
			}

			if b != 59 {
				let mods = if p1 > 1 then p1 -1 & 7 else 0
				if b == 126 {
					emit(mut out, tilde_key(if p0 < 0 then 0 else p0), mods)
				} else {
					emit(mut out, letter_key(b), mods)
				}

				return i + 1
			}
		} else if b < 32 || i > 32 {
			// Garbage, or far too long: give up on the sequence.
			emit(mut out, K_UNKNOWN, 0)
			return i + 1
		}

		i += 1
	}
}

























