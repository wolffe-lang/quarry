//! keys: bytes from the terminal in, keys out. No I/O, so every case is
//! a test. Characters are their Unicode scalar; named keys live one past
//! Unicaode, at KEY_BASE and up.

/// The first named key: one past the last Unicode scalar.
pub const KEY_BASE: int = 1114112

/// Up arrow
pub const K_UP: int = 1114113

/// Down arrow.
pub const K_DOWN: int = 1114114

/// Left arrow.
pub const K_LEFT: int = 1114115

/// Right arrow.
pub const K_RIGHT: int = 1114116

/// Home.
pub const K_HOME: int = 1114117

/// End. 
pub const K_END: int = 1114118

/// Page Up.
pub const K_PGUP: int = 1114119

/// Page Down.
pub const K_PGDN: int = 1114120

/// Insert.
pub const K_INS: int = 1114121

/// Delete.
pub const K_DEL: int = 1114122

/// Escape, alone.
pub const K_ESC: int = 1114123

/// Enter (CR or LF).
pub const K_ENTER: int = 1114124

/// Tab.
pub const K_TAB: int = 1114125

/// Backspace (127; Ctrl+Backspace is 8).
pub const K_BACKSPACE: int = 1114126

/// A sequence quarry does not know.
pub const K_UNKNOWN: int = 1114127

/// F1 is K_F0 + 1, F12 is K_F0 + 12.
pub const K_f0: int = 1114200

/// Shift was held.
pub const MOD_SHIFT: int = 1

/// Alt was held (or the key came after a lone ESC).
pub const MOD_ALT: int = 2

/// Ctrl was held.
pub const MOD_CTRL: int = 4

/// How long a lone ESC waits for the rest of a sequence. PAX's clock
/// ticks every 10 ms, so never go below one tick.
pub const ESC_TIMEOUT_MS: int = 25

/// One key: a scalar or a named key, and the modifiers held.
pub struct Key {
	code: int,
	mods: int,
}

/// The decoder: bytes not yet turned into keys, and the deadline for a
/// lone ESC (-1: none armed).
pub struct Decoder {
	pending: List[byte],
	esc_deadline_ms: int,
}

/// An empty decoder.
pub fn new() -> Decoder {
	Decoder { pending: List[byte](), esc_deadline_ms: -1 }
}

/// Append bytes. New bytes cancel a pending ESC deadline: the rest of the
/// sequence arrived.
pub fn feed(mut d: Decoder, bytes: List[byte]) {
	for b in bytes {
		(mut d.pending).push(b)	
	}

	if bytes.len > 0 {
		d.esc_deadline_ms = -1
	}
	
}

/// When the loop must wake to time out a lone ESC, or -1.
pub fn deadline(d: Decoder) -> int {
	d.esc_deadline_ms
}

fn at(d: Decoder, i: int) -> int {
	if i < d.pending.len then d.pending[i] as int else -1
}

/// Drop the first n pending bytes, in place. (Assigning a new list to
/// `d.pending` would keep the old one's storage until the decoder's
/// region ends: a leak per key in a program that runs for hours.)
fn consume(mut d: Decoder, n: int) {
	var i = n

	while i < d.pending.len {
		d.pending[i - n] = d.pending[i]
		i += 1
	}

	var drop = if n < d.pending.len then n else d.pending.len
	while drop > 0 {
		let _ = (mut d.pending).pop() else 0 as byte
		drop -= 1
	}
}

fn emit(mut out: Key, code: int, mods: int) -> bool {
	out.code = code
	out.mods = mods

	true
}

/// The key for a CSI's final letter (A-D arrows, H/F home/end, P-S F1-F4).
fn letter_key(f: int) {
	if f == 65 { return K_UP }
	if f == 66 { return K_DOWN }
	if f == 67 { return K_RIGHT }
	if f == 68 { return K_LEFT }
	if f == 72 { return K_HOME }
	if f == 70 { return K_END }
	if f >= 80 && f <= 83 { return K_F0 + 1 + (f - 80) }

	K_UNKNOWN
}

/// The key for `CSI n ~`.
fn tilde_key(n: int) -> int {
	if n == 1 || n == 7 { return K_HOME }
	if n == 2 { return K_INS }
	if n == 3 { return K_DEL }
	if n == 4 || n == 8 { return K_END }
	if n == 5 { return K_PGUP }
	if n == 6 { return K_PGDN }
	if n >= 11 && n <= 15 { return K_F0 + (n - 10) }
	if n >= 17 && n <= 21 { return K_F0 + (n - 11) }
	if n == 23 || n == 24 { return K_F0 + (n - 12) }

	K_UNKNOWN
}

/// Decode a CSI sequence that starts at pending[0..2] = ESC p. Answers
/// the bytes it used, or 0 when the sequence is not complete yet.
fn csi(d: Decoder, mut out: Key) -> int {
	// PAX's console (and the Linux console) send F1-F5 as ESC [ [ A..E.
	if at(d, 2) == 91 {
		let f = at(d, 3)
		if f < 0 { return 0 }
		if f >= 65 && f <= 69 {
			emit(mut out, K_F0 + 1 + (f - 65), 0)
		} else {
			emit(mut out, K_UNKNOWN, 0)
		}

		return 4
	}

	// Parameters: digits and ';', then one final byte in 0x40..0x7e.
	// Only the first two parameters matter (the key number and the
	// modifiers), so they live in two ints: no list, no allocation.
	var p0 = -1
	var p1 = -1
	var count = 0
	var cur = -1
	var i = 2

	loop {
		let b = at(d, i)
		if b < 0 { return 0 }
		if b >= 48 && b <= 57 {
			cur = (if cur < 0 then 0 else cur) * 10 + (b - 48)
			if cur > 9999 { cur = 9999 }
		} else if b == 59 || b >= 64 && b <= 126 {
			if b == 59 || cur >= 0 {
				let v = if cur < 0 then 1 else cur
				if count == 0 { p0 = v }
				if count == 1 { p1 = v }
				count += 1
				cur = -1
			}

			if b != 59 {
				let mods = if p1 > 1 then p1 -1 & 7 else 0
				if b == 126 {
					emit(mut out, tilde_key(if p0 < 0 then 0 else p0), mods)
				} else {
					emit(mut out, letter_key(b), mods)
				}

				return i + 1
			}
		} else if b < 32 || i > 32 {
			// Garbage, or far too long: give up on the sequence.
			emit(mut out, K_UNKNOWN, 0)
			return i + 1
		}

		i += 1
	}
}

/// Bytes a UTF-8 sequence starting with `b` takes, or 1 for a bad lead.
fn utf8_len(b: int) -> int {
	if b < 128 { return 1 }
	if b >= 194 && b <= 223 { return 2 }
	if b >= 224 && b <= 239 { return 3 }
	if b >= 240 && b <= 244 { return 4 }
	1
}

/// Produce the next key, if one is complete. `now_ms` is the monotonic
/// clock in milliseconds. Answers false when nothing (or only part of a
/// sequence) is pending.
pub fn next(mut d: Decoder, now_ms: int, mut out: Key) -> bool {
	let b0 = at(d, 0)

	if b0 < 0 {
		return false
	}

	if b0 == 27 {
		let b1 = at(d, 1)
		if b1 < 0 {
			// A lone ESC: a key, or the start of a sequence still arriving.
			if d.esc_deadline_ms < 0 {
				d.esc_deadline_ms = now_ms + ESC_TIMEOUT_MS
				return false
			}

			if now_ms < d.esc_deadline_ms {
				return false
			}

			d.esc_deadline_ms = -1
			consume(mut d, 1)

			return emit(mut out, K_ESC, 0)
		}

		if b1 == 91 {
			let used = csi(d, mut out)
			if used == 0 { return false }
			consume(mut d, used)
			return true
		}

		if b1 == 79 {
			// SS3: xterms F1-F4 and application-mode arrows and Home/End.
			let f = at(d, 2)
			if f < 0 { return false }
			consume(mut d, 3)

			return emit(mut out, letter_key(f), 0)
		}

		if b1 == 27 {
			consume(mut d, 1)
			return emit(mut out, K_ESC, 0)
		}

		// ESC then a key: that key with Alt.
		consume(mut d, 1)
		let ok = next(mut d, now_ms, mut out)
		if ok { out.mods = out.mods | MOD_ALT }

		return ok
	}
	
	if b0 == 13 || b0 == 10 {
		consume(mut d, 1)
		return emit(mut out, K_ENTER, 0)
	}

	if b0 == 9 {
		consume(mut d, 1)
		return emit(mut out, K_TAB, 0)
	}

	if b0 == 127 || b0 == 8 {
		consume(mut d, 1)
		return emit(mut out, K_BACKSPACE, if b0 == 8 then MOD_CTRL else 0)
	}

	if b0 < 32 {
		// Ctrl+A .. Ctrl+z arrive as 1..26.
		consume(mut d, 1)
		return emit(mut out, b0 + 96, MOD_CTRL)
	}

	let n = utf8_len(b0)

	if d.pending.len < n {
		return false
	}

	var cp = b0
	if n == 2 { cp = b0 & 31 }
	if n == 3 { cp = b0 & 15 }
	if n == 4 { cp = b0 & 7 }

	var i = 1
	while i < n {
		cp = cp * 64 + (at(d, i) & 63)
		i += 1
	}

	consume(mut d, n)
	emit(mut out, cp, 0)
}

/// True for a value `as char` accepts: 0..0x10FFFF minus the surrogates.
/// (`int as char` traps on anything else.)
pub fn is_scalar(c: int) -> bool {
	c >= 0 && c < 55296 || c >= 57344 && c < 1114112
}

/// A key's name, for the key viewer and for status messages.
pub fn name(k: Key) -> str {
	var base = ""
	let c = k.code

	if c == K_UP {
		base = "Up"
	} else if c == K_DOWN {
		base = "Down"
	} else if c == K_LEFT {
		base = "Left"
	} else if c == K_RIGHT {
		base = "Right"
	} else if c == K_HOME {
		base = "Home"
	} else if c == K_END {
		base = "End"
	} else if c == K_PGUP {
		base = "PgUp"
	} else if c == K_PGDN {
		base = "PgDn"
	} else if c == K_INS {
		base = "Ins"
	} else if c == K_DEL {
		base = "Del"
	} else if c == K_ESC {
		base = "Escape"
	} else if c == K_ENTER {
		base = "Enter"
	} else if c == K_TAB {
		base = "Tab"
	} else if c == K_BACKSPACE {
		base = "Backspace"
	} else if c == K_UNKNOWN {
		base = "Unknown"
	} else if c > K_F0 && c <= K_F0 + 24 {
		base = "F{c - K_F0}"
	} else if c == 32 {
		base = "Space"
	} else if is_scalar(c) {
		base = "'{c as char}'"
	} else {
		base = "U+{c}"
	}

	var pre = ""
	if k.mods & MOD_CTRL != 0 { pre += "Ctrl+" }
	if k.mods & MOD_ALT != 0 { pre += "Alt+" }
	if k.mods & MOD_SHIFT != 0 { pre += "Shift+" }
	"{pre}{base}"
}



















