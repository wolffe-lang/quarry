//! member: false
//! job's tests: the worker's lines in, the numbers out. No child process.

use job
use std.hex

fn test_lines_set_the_numbers() {
	var j = job.idle()
	job.take_line(mut j, "total 3 4096")

	assert(j.total_files == 3 && j.total_bytes == 4096, "total")

	let path = "/home/me/a file.txt"
	job.take_line(mut j, "file {hex.encode(path.bytes())}")

	assert(j.files == 1, "one file started")
	assert((str_from_utf8(j.current) else "") == path, "the destination, through hex")

	job.take_line(mut j, "bytes 1024")

	assert(j.bytes == 1024, "bytes")
	assert(job.permille(j) == 250, "a quarter: {job.permille(j)}")

	job.take_line(mut j, "done")

	assert(j.failure.len == 0, "no failure")
}

fn test_an_error_line_and_a_stray_line() {
	var j = job.idle()

	job.take_line(mut j, "error cannot create /x: denied")

	assert((str_from_utf8(j.failure) else "") == "cannot create /x: denied", "error text")

	var k = job.idle()
	job.take_line(mut k, "trap(bounds): index 9 of 3")

	assert(
		(str_from_utf8(k.failure) else "") == "trap(bounds): index 9 of 3",
		"a stray line is kept",
	)
}

fn test_permille_without_bytes_counts_files() {
	var j = job.idle()
	job.take_line(mut j, "total 4 0")
	job.take_line(mut j, "file 61")

	assert(job.permille(j) == 250, "by files: {job.permille(j)}")

	job.take_line(mut j, "total 1 10")
	job.take_line(mut j, "bytes 99")

	assert(job.permille(j) == 1000, "never past the end")
}

fn test_an_into_line_names_the_copy() {
	var j = job.idle()
	let first = "/home/me/src/notes-1.txt"
	job.take_line(mut j, "into {hex.encode(first.bytes())}")
	job.take_line(mut j, "into {hex.encode("/home/me/src/zz.txt".bytes())}")

	assert((str_from_utf8(j.into) else "") == first, "the first copy's path")
}

fn test_the_queue_keeps_its_order_and_gives_back_its_room() {
	var q = job.queue()
	var one = List[str]()
	(mut one).push("/a/one")
	(mut one).push("/a/two")
	job.enqueue(mut q, "/dest", one)

	var two = List[str]()
	(mut two).push("/b/three")
	job.enqueue(mut q, "/other", two)

	let waiting = q.count
	let first = job.dequeue(mut q)
	let left = q.pool.len
	let second = job.dequeue(mut q)
	let none = job.dequeue(mut q)

	assert(waiting == 2, "two waiting: {waiting}")
	assert(first.len == 3 && first[0] == "/dest" && first[2] == "/a/two", "the first copy")
	assert(left == "/other".len + "/b/three".len + 3, "the pool holds only what waits: {left}")
	assert(second.len == 2 && second[1] == "/b/three", "then the second")
	assert(none.len == 0 && q.count == 0 && q.pool.len == 0, "then none")

	job.enqueue(mut q, "/x", two)
	job.drop_all(mut q)

	assert(q.count == 0 && q.pool.len == 0, "dropped")
}