//! member: false
//! ui's tests: draw into a grid and read the grid back as text. No
//! terminal, so a layout change shows up here first

use grid
use pane
use std.fs
use ui

fn test_fit_keeps_both_ends() {
	assert(ui.fit("short", 10) == "short", "fits")
	assert(ui.fit("abcdefghij", 7) == "abc~hij", "cut: {ui.fit("abcdefghij", 7)}")
	assert(ui.cells("cafe") == 4, "four cells")
	assert(ui.head("cafe", 4) == "cafe" && ui.tail("cafe", 2) == "fe", "head and tail")
}

fn test_short_path_uses_tilde_and_cuts_from_the_left() {
	assert(ui.short_path("/home/me","/home/me", 20) == "~", "home itself")
	assert(ui.short_path("/home/me/src", "/home/me", 20) == "~/src", "under home")
	assert(ui.short_path("/home/meat", "/home/me", 20) == "/home/meat", "not under home")
	assert(ui.short_path("/a/very/long/path/here", "", 12) == "...path/here", "cut")
}

fn test_two_panes_at_80_by_24() {
	fs.remove_dir_all("ut-screen.tmp") else |_| {}
	fs.create_dir_all("ut-screen.tmp/docs") else |_| {}
	fs.write_text("ut-screen.tmp/readme.md", "hello") else |_| {}

	let base = fs.realpath("ut-screen.tmp") else ""
	let home = fs.parent(base) else ""
	var p = pane.new(base)

	pane.load(mut p) else |_| {
		assert(false, "load failed")
	}

	var g = grid.new(24, 80)
	let look = grid.Look { gl: grid.box_glyphs(), color: false }

	ui.draw(mut g, look, p, p, 0, home, "", " Tab Pane   q Quit")

	let top = grid.row_text(g, 0)
	let first = grid.row_text(g, 1)
	let second = grid.row_text(g, 2)
	let status = grid.row_text(g, 22)
	let bar = grid.row_text(g, 23)
	let bottom = grid.row_text(g, 21)

	fs.remove_dir_all("ut-screen.tmp") else |_| {}

	assert(ui.cells(top) == 80, "the top row is 80 cells")
	assert(status.starts_with(" drwx"), "status: {status}")
	assert(bar.starts_with(" Tab Pane   q Quit"), "key bar: {bar}")
}
