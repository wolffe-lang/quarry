//! member: false
//! The grid and the renderer, without a terminal.

use grid

fn bytes_text(b: List[byte]) -> str {
	str_from_utf8(b) else "<not utf-8>"
}

fn test_put_clips_at_every_edge() {
	var g = grid.new(3, 4)

	grid.put(mut g, -1, 0, 65, grid.DEFAULT, grid.DEFAULT, 0)
	grid.put(mut g, 0, 4, 65, grid.DEFAULT, grid.DEFAULT, 0)
	grid.put(mut g, 3, 0, 65, grid.DEFAULT, grid.DEFAULT, 0)
	grid.put(mut g, 2, 3, 66, grid.DEFAULT, grid.DEFAULT, 0)

	assert(grid.row_text(g, 2) == "   B")
	assert(grid.row_text(g, 0) == "    ")
}

fn test_puts_truncates_and_sanitizes() {
	var g = grid.new(1, 6)
	let used = grid.puts(mut g, 0, 1, 3, "a\x1bbcdef", grid.DEFAULT, grid.DEFAULT, 0)

	assert(used == 3)
	assert(grid.row_text(g, 0) == " a?b  ")
}

fn test_frame_draws_corners() {
	var g = grid.new(3, 5)
	grid.frame(mut g, 0, 0, 3, 5, grid.ascii_glyphs(), grid.DEFAULT)

	assert(grid.row_text(g, 0) == "+---+")
	assert(grid.row_text(g, 1) == "|   |")
	assert(grid.row_text(g, 2) == "+---+")
}

fn test_no_change_renders_nothing() {
	let a = grid.new(2, 10)
	let b = grid.new(2, 10)
	var out = List[byte]()

	assert(grid.render(a, b, mut out) == 0)
}

fn test_one_changed_cell_is_one_jump_and_one_byte() {
	let front = grid.new(2, 10)
	var back = grid.new(2, 10)

	grid.put(mut back, 0, 3, 88, grid.DEFAULT, grid.DEFAULT, 0)

	var out = List[byte]()

	grid.render(front, back, mut out)

	assert(bytes_text(out) == "\x1b[1;4H\x1b[0mX", "got {bytes_text(out)}")
}

fn test_reverse_bar_then_reset() {
	let front = grid.new(1, 4)
	var back = grid.new(1, 4)

	grid.fill(mut back, 0, 0, 2, 65, grid.DEFAULT, grid.DEFAULT, grid.ATTR_REVERSE)

	var out = List[byte]()

	grid.render(front, back, mut out)
	assert(bytes_text(out) == "\x1b[1;1H\x1b[0;7mAA\x1b[0m", "got {bytes_text(out)}")
}

fn test_a_whole_screen_after_invalidate() {
	var front = grid.new(2, 3)

	grid.invalidate(mut front)

	let back = grid.new(2, 3)
	var out = List[byte]()

	let n = grid.render(front, back, mut out)

	// Six cells, less the bottom-right one, which is never written
	assert(n > 0)
	assert(bytes_text(out) == "\x1b[1;1H\x1b[0m   \x1b[2;1H  ", "got {bytes_text(out)}")
}
