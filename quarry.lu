//! member: false
//! quarry, step 5: two panes on real directories. The model is two
//! `pane.Pane`s and which one is active; `ui.draw` turns it into
//! a frame; keys move the cursor, switch panes and walk the tree

use job
use dialog
use grid
use keys
use pane
use std.env
use std.fs
use std.signal
use std.time
use tty
use ui

/// The longest input quarry drains in one turn before it draws.
const DRAIN_MAX: int = 262144

/// How often quarry looks at the panes' directories, in milliseconds
const POLL_MS: int = 1000

/// The last row of the screen: what the keys do.
const KEYBAR: str = " F5 Copy  F6 Rename  F7 Mkdir  F8 Delete  Space Mark  Tab Pane  ^R Reload  q Quit"

/// What a dialog's yes does: rename the entry under the cursor.
const ACT_MKDIR: int = 1

/// What a dialog's yes does: rename the entry under the cursor.
const ACT_RENAME: int = 2

/// What a dialog's yes does: delete the targets.
const ACT_DELETE: int = 3

/// Everything the program knows
struct App {
	t: tty.Tty, 
	look: grid.Look,
	front: grid.Grid,
	back: grid.Grid,
	out: List[byte],
	dec: keys.Decoder,
	running: bool,
	dirty: bool,
	panes: List[pane.Pane],
	active: int,
	home: str,
	status: List[byte],
	next_poll_ms: int,
	dlg: dialog.Dialog,
	copying: job.Job,
}


/// Box drawing unless the terminal is dumb, color unless NO_COLOR.
fn look_from_env() -> grid.Look {
	let term = env.get("TERM") else ""
	let no_color = env.get("NO_COLOR") else ""
	let gl = if term == "" || term == "dumb" then grid.ascii_glyphs() else grid.box_glyphs()

	grid.Look { gl: gl, color: no_color == "" && term != "dumb" }
}

fn now_ms() -> int {
	time.monotonic_ns() / 1000000
}

/// Put `text` on the status line until the next key.
fn say(mut a: App, text: str) {
	(mut a.status).reset()
	for b in text.bytes() {
		(mut a.status).push(b)
	}
}

/// Draw, diff, write once. The strings built while drawing and the 
/// escape sequences buillt while rendering die with the region
fn paint(mut a: App) {
	(mut a.out).reset()

	region scratch {
		let rows = ui.list_rows(a.t.rows)

		pane.settle(mut a.panes[0], rows)
		pane.settle(mut a.panes[1], rows)

		let status = str_from_utf8(a.status) else ""

		ui.draw(mut a.back, a.look, a.panes[0], a.panes[1], a.active, a.home, status, KEYBAR)

		if a.copying.running {
			ui.draw_progress(mut a.back, a.look, a.copying)
		}

		if a.dlg.kind != dialog.NONE {
			ui.draw_dialog(mut a.back, a.look, a.dlg)
		}
		
		let _ = grid.render(a.front, a.back, mut a.out)	
	}

	tty.write(a.out) else |_| {
		a.running = false
	}

	grid.assign(mut a.front, a.back)
	a.dirty = false
}

/// How long the wait may sleep: until the ESC deadline, or the next look
/// at the disk, whichever is sooner.
fn wait_ms(a: App) -> int {
	var due = a.next_poll_ms
	let esc = keys.deadline(a.dec)

	if esc >= 0 && esc < due {
		due = esc
	}
	
	let now = now_ms()
	if due > now then due - now else 0
}

/// The window changed size: new grids, everything redrawn.
fn resized(mut a: App) {
	tty.refresh_size(mut a.t)
	grid.resize(mut a.front, a.t.rows, a.t.cols)
	grid.invalidate(mut a.front)
	grid.resize(mut a.back, a.t.rows, a.t.cols)
	a.dirty = true
}

/// Read everything waiting on stdin into the decoder: read, then look
/// again without sleeping, until nothing is left (or DRAIN_MAX). A 
/// signal meaning seen while looking is handed back, never dropped.
fn drain(mut a: App, files: List[fs.File]) -> int {
	var total = 0
	loop {
		var got = 0
		var ended = false
		region scratch {
			let bytes = tty.read(4096) else |_| {
				List[byte]()
			}

			if bytes.len == 0 {
				ended = true
			}

			keys.feed(mut a.dec, bytes)
			got = bytes.len
		}

		if ended {
			a.running = false
			return 0
		}

		total += got
		if total >= DRAIN_MAX {
			return 0
		}

		let w = tty.wait(files, 0) else |_| {
			return 0
		}

		if w.meaning != 0 || w.ready != 0 {
			return w.meaning
		}
	}
}

/// Enter the directory under the cursor.
fn open(mut a: App) {
	let went = pane.enter(mut a.panes[a.active]) else |e| {
		say(mut a, "cannot open that directory: {e}")
		return
	}

	if !went {
		say(mut a, "not a directory")
	}
}

/// Go to the parent directory
fn go_up(mut a: App) {
	pane.up(mut a.panes[a.active]) else |e| {
		say(mut a, "cannot open the parent: {e}")
	}
}

/// Pane `i`'s directory vanished: walk up and say where we landed.
fn recover(mut a: App, i: int) {
	if pane.recover(mut a.panes[i]) {
		say(mut a, "that directory is gone; now in {pane.path_of(a.panes[i])}")
	} else {
		say(mut a, "that directory is gone, and nothing above it can be listed")
	}
}

/// Read pane `i` again.
fn reload(mut a: App, i: int) {
	pane.load(mut a.panes[i]) else |e| match e {
		not_found => {
			recover(mut a, i)
		},
		denied => {
			say(mut a, "cannot reload: denied")
		},
		io => {
			say(mut a, "cannot reload: io")
		},
	}
}

/// Once a second: reload a pane whose directory changed, and walk up
/// from one that vanished
fn poll_disk(mut a: App) {
	let now = now_ms()
	if now < a.next_poll_ms {
		return
	}

	a.next_poll_ms = now + POLL_MS
	var i = 0
	while i < 2 {
		region scratch {
			let c = pane.changed(a.panes[i])

			if c == 1 {
				reload(mut a, i)
				a.dirty = true
			} else if c == 2 {
				recover(mut a, i)
				a.dirty = true
			}
		}

		i += 1
	}
}

/// Show or hide dot files in the active pane.
fn toggle_hidden(mut a: App) {
	a.panes[a.active].show_hidden = !a.panes[a.active].show_hidden
	pane.load(mut a.panes[a.active]) else |e| {
		say(mut a, "cannot reload: {e}")
	}
}

/// Whether `name` can be a single file name: not empty, not `.` or
/// `..`, and no `/`.
fn valid_name(name: str) -> bool {
	if name == "" || name == "." || name == ".." {
		return false
	}

	for b in name.bytes() {
		if b as int == 47 || b as int == 0 {
			return false
		}
	}

	true
}

/// Whether anything is at `path`, a dangling link included.
fn present(path: str) -> bool {
	let _ = fs.lstat(path) else |_| {
		return false	
	}

	true
}

fn make_dir(mut a: App, name: str) {
	if !valid_name(name) {
		say(mut a, "not a file name: {name}")
		return
	}

	let path = fs.join(pane.path_of(a.panes[a.active]), name)

	fs.create_dir(path) else |e| {
		say(mut a, "cannot make {name}: {e}")
		return
	}

	reload(mut a, a.active)
	let _ = pane.cursor_to(mut a.panes[a.active], name)
}

fn rename(mut a: App, name: str) {
	let p = a.active
	let from = pane.child_path(a.panes[p], a.panes[p].cursor) else |_| {
		say(mut a, "quarry cannot reach a name that is not UTF-8")
		return
	}

	if !valid_name(name) {
		say(mut a, "not a file name: {name}")
		return
	}

	let to = fs.join(pane.path_of(a.panes[p]), name)

	if to == from {
		return
	}

	// move_file replaces what is there, quarry never does that silently
	if present(to) {
		say(mut a, "{name} already exists")
		return
	}
	fs.move_file(from, to) else |e| {
		say(mut a, "cannot rename: {e}")
		return
	}

	reload(mut a, p)
	let _ = pane.cursor_to(mut a.panes[p], name)
}

fn delete(mut a: App) {
	let p = a.active
	let t = pane.targets(a.panes[p])
	var gone = 0
	var failed = 0

	for i in t {
		let path = pane.child_path(a.panes[p], i) else ""
		if path == "" {
			failed += 1
			continue
		}

		let info = fs.lstat(path) else |_| {
			failed += 1
			continue
		}

		// lstat: a link to a directory is removed as a link, never followed.
		if info.kind == pane.KIND_DIR {
			fs.remove_dir_all(path) else |_| {
				failed += 1
				continue
			}
		} else {
			fs.remove(path) else |_| {
				failed += 1
				continue
			}
		}

		gone += 1
	}

	reload(mut a, 0)
	reload(mut a, 1)

	if failed > 0 {
		say(mut a, "deleted {gone}; {failed} could not be deleted")
	} else {
		say(mut a, "deleted {gone}")
	}
}

/// The dialog was accepted: do what it was opened for.
fn act(mut a: App) {
	let action = a.dlg.action
	let text = dialog.text_of(a.dlg)
	dialog.close(mut a.dlg)

	if action == ACT_MKDIR {
		make_dir(mut a, text)
	} else if action == ACT_RENAME {
		rename(mut a, text)
	} else if action == ACT_DELETE {
		delete(mut a)
	}
}

/// F5: copy the targets into the other pane's directory, in the
/// background.
fn start_copy(mut a: App) {
	if a.copying.running {
		say(mut a, "a copy is already running")
		return
	}

	let src = a.active
	let dest = pane.path_of(a.panes[1 - src])

	if dest == pane.path_of(a.panes[src]) {
		say(mut a, "both panes show this directory; point the other one elsewhere")
		return 
	}

	var sources = List[str]()

	for i in pane.targets(a.panes[src]) {
		let path = pane.child_path(a.panes[src], i) else |_| {
			say(mut a, "quarry cannot reach a name that is not UTF-8")
			return
		}

		(mut sources).push(path)		
	}

	if sources.len == 0 {
		return 
	}

	let exe = os_exe() else |_| {
		say(mut a, "cannot find quarry's own program to start the copy")
		return
	}

	job.start(mut a.copying, exe, dest, sources) else |e| {
		say(mut a, "cannot start the copy: {e}")
		return
	}

	pane.clear_marks(mut a.panes[src])
}

/// The worker ended: say how, remove what a cancel left behind, reload.
fn finish_copy(mut a: App) {
	let removed = job.clean_up(mut a.copying)

	if a.copying.cancelled {
		if removed != "" {
			say(mut a, "copy cancelled; removed the partial {removed}")
		} else {
			say(mut a, "copy cancelled")
		}
	} else if a.copying.status != 0 {
		let why = str_from_utf8(a.copying.failure) else ""
		say(mut a, "copy failed: {why}")
	} else {
		say(mut a, "copied {a.copying.files} items, {pane.human_size(a.copying.bytes)}")
	}

	reload(mut a, 0)
	reload(mut a, 1)
	a.dirty = true
}

/// Read the worker's pipe when it has something. `pipe` holds only the
/// pipe, so a key flood on stdin cannot hide it. Answers any meaning the
/// look took off the queue.
fn service_copy(mut a: App, pipe: List[fs.File]) -> int {
	let w = tty.wait(pipe, 0) else |_| {
		return 0
	}

	if w.ready == 0 {
		if job.pump(mut a.copying) {
			region scratch {
				finish_copy(mut a)
			}
		}

		a.dirty = true
	}

	w.meaning
}


/// The question F8 asks about pane `p`'s targets.
fn delete_question(p: pane.Pane) -> str {
	let t = pane.targets(p)

	if t.len == 1 {
		return "Delete {pane.display_name(p, t[0])}? (y/N)"
	}
	"Delete {t.len} marked items? (y/N)"
}

/// F8: ask first. The default answer is no.
fn ask_delete(mut a: App) {
	if pane.targets(a.panes[a.active]).len == 0 {
		return
	}

	dialog.ask(mut a.dlg, ACT_DELETE, delete_question(a.panes[a.active]))
}

/// F6: edit the name in place.
fn ask_rename(mut a: App) {
	let i = a.active
	if a.panes[i].cursor >= a.panes[i].entries.len {
		return
	}

	let name = pane.display_name(a.panes[i], a.panes[i].cursor)
	dialog.edit(mut a.dlg, ACT_RENAME, "Rename {name} to:", name)
}

/// One key changes the model, never the screen
fn on_key(mut a: App, k: keys.Key) {
	a.dirty = true

	if a.dlg.kind != dialog.NONE {
		let r = dialog.key(mut a.dlg, k)
		if r == dialog.ACCEPT {
			act(mut a)
		} else if r == dialog.CANCEL {
			dialog.close(mut a.dlg)
		}
		
		return
	}

	(mut a.status).reset()
	let page = ui.list_rows(a.t.rows) - 1
	let c = k.code
	let plain = k.mods == 0

	if c == 113 && plain || c == keys.K_F0 + 10 {
		a.running = false
	} else if c == keys.K_DOWN {
		pane.move_by(mut a.panes[a.active], 1)
	} else if c == keys.K_UP {
		pane.move_by(mut a.panes[a.active], -1)
	} else if c == keys.K_PGDN {
		pane.move_by(mut a.panes[a.active], page)
	} else if c == keys.K_PGUP {
		pane.move_by(mut a.panes[a.active], 0 - page)
	} else if c == keys.K_HOME {
		a.panes[a.active].cursor = 0
	} else if c == keys.K_END {
		a.panes[a.active].cursor = a.panes[a.active].entries.len - 1
	} else if c == keys.K_TAB {
		a.active = 1 - a.active
	} else if c == keys.K_ENTER || c == keys.K_RIGHT {
		open(mut a)
	} else if c == keys.K_BACKSPACE || c == keys.K_LEFT {
		go_up(mut a)
	} else if c == 46 && plain {
		toggle_hidden(mut a)
	} else if c == 114 && k.mods == keys.MOD_CTRL {
		reload(mut a, 0)
		reload(mut a, 1)
	} else if c == keys.K_F0 + 7 {
		dialog.edit(mut a.dlg, ACT_MKDIR, "Make directory:", "")
	} else if c == keys.K_F0 + 6 {
		ask_rename(mut a)
	} else if c == keys.K_F0 + 8 || c == keys.K_DEL {
		ask_delete(mut a)
	} else if c == keys.K_F0 + 5 {
		start_copy(mut a)
	} else if c == keys.K_ESC && a.copying.running {
		job.cancel(mut a.copying)
		say(mut a, "cancelling the copy")
	}

	 else if c == 32 && plain || c == keys.K_INS {
		pane.toggle_mark(mut a.panes[a.active])
		pane.move_by(mut a.panes[a.active], 1)
	}

	a.dirty = true
}

fn run(mut a: App) {
	var files = List[fs.File]()
	var pipe = List[fs.File]()
	var k = keys.Key { code: 0, mods: 0 }

	while a.running {
		if a.dirty {
			paint(mut a)
		}

		// The keyboard is file 0; a running copy's pipe is file 1.
		(mut files).reset()
		(mut pipe).reset()
		(mut files).push(fs.stdin())

		if a.copying.running {
			(mut files).push(a.copying.out)
			(mut pipe).push(a.copying.out)
		}

		let w = tty.wait(files, wait_ms(a)) else |_| {
			break
		}

		var meaning = w.meaning

		if w.ready == 0 {
			meaning = meaning | drain(mut a, files)
		}

		if a.copying.running {
			meaning = meaning | service_copy(mut a, pipe)
		}

		if meaning & signal.suspend() != 0 {
			tty.suspend(mut a.t) else |_| {
				break
			}

			resized(mut a)
		}

		if meaning & signal.resize() != 0 {
			resized(mut a)
		}

		// Ctrl-C closes an open dialog instead of quitting.
		if meaning & signal.interrupt() != 0 && a.dlg.kind != dialog.NONE {
			dialog.close(mut a.dlg)
			meaning = meaning & !signal.interrupt()
			a.dirty = true
		}

		if meaning & !(signal.resize() | signal.suspend()) != 0 {
			break
		}

		poll_disk(mut a)
		while a.running &&  keys.next(mut a.dec, now_ms(), mut k) {
			region scratch {
				on_key(mut a, k)
			}
		}
	}

	// Quitting with a copy running: stop it and tidy up after it.
	if a.copying.running {
		job.cancel(mut a.copying)
		while !job.pump(mut a.copying) {}
		let _ = job.clean_up(mut a.copying)
	}
}

/// The absolute path quarry starts a pane on: the argument, or the working
/// directory.
fn start_path(arg: str) -> str ! {not_found} {
	let p = if arg == "" then "." else arg
	fs.realpath(p) else |_| {
		return not_found
	}
}

fn main() -> !int {
	let args = env_args()
	if (args.get(0) else "") == "--worker" {
		return worker.main(args[1..args.len])
	}

	let left_arg = env_args().get(0) else ""
	let right_arg = env_args().get(1) else left_arg
	var panes = List[pane.Pane]()

	for arg in [left_arg, right_arg] {
		let path = start_path(arg) else |_| {
			eprint("quarry: no such directory: {arg}")
			return 1
		}

		var p = pane.new(path)
		pane.load(mut p) else |e| {
			eprint("quarry: cannot list {path}: {e}")
			return 1
		}
		(mut panes).push(p)
	}

	var t = tty.open() else |e| {
		eprint("quarry: standard input and output must be a terminal ({e})")
		return 1
	}

	tty.enter(mut t) else |_| {
		eprint("quarry: the terminal refused raw mode")
		return 1
	}

	var front = grid.new(t.rows, t.cols)
	grid.invalidate(mut front)
	let back = grid.new(t.rows, t.cols)

	var a = App {
		t: t,
		look: look_from_env(),
		front: front, 
		back: back,
		out: List[byte](), 
		dec: keys.new(),
		running: true, 
		dirty: true,
		panes: panes,
		active: 0, 
		home: env.get("HOME") else "",
		status: List[byte](),
		next_poll_ms: now_ms() + POLL_MS,
		dlg: dialog.closed(),
		copying: job.idle(),
	}

	run(mut a)
	tty.leave(mut a.t)

	0
}