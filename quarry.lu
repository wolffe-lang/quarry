//! quarry: a two-pane file manager for PAX's console and any terminal.
//! The left pane is where you are; the right pane is what is under the
//! left pane's cursor.

use std.process
use worker
use job
use dialog
use grid
use keys
use nav
use pane
use paste
use preview
use std.env
use std.fs
use std.signal
use std.time
use tty
use ui

/// The longest input quarry drains in one turn before it draws.
const DRAIN_MAX: int = 262144

/// How often quarry looks at the panes' directories, in milliseconds
const POLL_MS: int = 1000

/// How long the left cursor must rest before the right pane follows it,
/// in milliseconds. A held arrow repeats faster than this, so it never
/// makes a view it would throw away.
const SETTLE_MS: int = 60

/// The last row of the screen: what the keys do.
const KEYBAR: str = " F4 Edit  F5 Copy  F6 Rename  F7 Mkdir  F8 Delete  Space Mark  ? Help  q Quit"

/// The last row in copy mode.
const COPYBAR: str = " COPY  arrows choose a place  Enter Paste  F7 Mkdir  ? Help  Esc Cancel"

/// What a dialog's yes does: rename the entry under the cursor.
const ACT_MKDIR: int = 1

/// What a dialog's yes does: rename the entry under the cursor.
const ACT_RENAME: int = 2

/// What a dialog's yes does: delete the targets.
const ACT_DELETE: int = 3

/// What a dialog's yes does: stop the running copy and the ones waiting.
const ACT_STOP: int = 4

/// What a dialog's yes does: stop the copies and quit.
const ACT_QUIT: int = 5

/// Everything the program knows
struct App {
	t: tty.Tty, 
	look: grid.Look,
	front: grid.Grid,
	back: grid.Grid,
	out: List[byte],
	dec: keys.Decoder,
	running: bool,
	dirty: bool,
	panes: List[pane.Pane],
	active: int,
	view: nav.View,
	due_ms: int,
	cache: preview.Cache,
	shown: int,
	copy_mode: bool,
	payload: paste.Payload,
	back_to: nav.Spot,
	land: List[byte],
	help: bool,
	home: str,
	status: List[byte],
	next_poll_ms: int,
	dlg: dialog.Dialog,
	copying: job.Job,
	queue: job.Queue,
}


/// Box drawing unless the terminal is dumb, color unless NO_COLOR.
fn look_from_env() -> grid.Look {
	let term = env.get("TERM") else ""
	let no_color = env.get("NO_COLOR") else ""
	let gl = if term == "" || term == "dumb" then grid.ascii_glyphs() else grid.box_glyphs()

	grid.Look { gl: gl, color: no_color == "" && term != "dumb" }
}

fn now_ms() -> int {
	time.monotonic_ns() / 1000000
}

/// Put `text` on the status line until the next key.
fn say(mut a: App, text: str) {
	(mut a.status).reset()
	for b in text.bytes() {
		(mut a.status).push(b)
	}
}

/// Draw, diff, write once. The strings built while drawing and the 
/// escape sequences buillt while rendering die with the region
fn paint(mut a: App) {
	(mut a.out).reset()

	region scratch {
		let rows = ui.list_rows(a.t.rows)

		pane.settle(mut a.panes[0], rows)
		pane.settle(mut a.panes[1], rows)
		var status = str_from_utf8(a.status) else ""
		if status == "" && a.copy_mode {
			status = copy_hint(a)
		}
		let bar = if a.copy_mode then COPYBAR else KEYBAR
		let l = a.view.left
		let side = if a.active == l then 0 else 1
		ui.draw(mut a.back, a.look, a.panes[l], a.panes[1 - l], side, a.home, status, bar)
		if a.view.shows == nav.SHOWS_FILE && a.shown >= 0 {
			ui.draw_preview(mut a.back, a.look, a.cache.slots[a.shown], a.home)
		} else if a.view.shows != nav.SHOWS_LISTING {
			let of = str_from_utf8(a.view.of) else ""
			let why = str_from_utf8(a.view.why) else ""

			ui.draw_note(mut a.back, a.look, of, why, a.home)
		}
		if a.copy_mode {
			ui.draw_sticky(mut a.back, a.look, a.panes[l], 0, a.payload)
			if a.view.shows == nav.SHOWS_LISTING {
				ui.draw_sticky(mut a.back, a.look, a.panes[1 - l], 1, a.payload)
			}
		}
		if a.copying.running {
			ui.draw_progress(mut a.back, a.look, a.copying, a.queue.count)
		}

		if a.dlg.kind != dialog.NONE {
			ui.draw_dialog(mut a.back, a.look, a.dlg)
		}
		if a.help {
			ui.draw_help(mut a.back, a.look)
		}
		
		let _ = grid.render(a.front, a.back, mut a.out)	
	}

	tty.write(a.out) else |_| {
		a.running = false
	}

	grid.assign(mut a.front, a.back)
	a.dirty = false
}

/// How long the wait may sleep: until the ESC deadline, or the next look
/// at the disk, whichever is sooner.
fn wait_ms(a: App) -> int {
	var due = a.next_poll_ms
	let esc = keys.deadline(a.dec)

	if esc >= 0 && esc < due {
		due = esc
	}

	if a.due_ms >= 0 && a.due_ms < due {
		due = a.due_ms
	}
	
	let now = now_ms()
	if due > now then due - now else 0
}

/// The window changed size: new grids, everything redrawn.
fn resized(mut a: App) {
	tty.refresh_size(mut a.t)
	grid.resize(mut a.front, a.t.rows, a.t.cols)
	grid.invalidate(mut a.front)
	grid.resize(mut a.back, a.t.rows, a.t.cols)
	a.dirty = true
}

/// Read everything waiting on stdin into the decoder: read, then look
/// again without sleeping, until nothing is left (or DRAIN_MAX). A 
/// signal meaning seen while looking is handed back, never dropped.
fn drain(mut a: App, files: List[fs.File]) -> int {
	var total = 0
	loop {
		var got = 0
		var ended = false
		region scratch {
			let bytes = tty.read(4096) else |_| {
				List[byte]()
			}

			if bytes.len == 0 {
				ended = true
			}

			keys.feed(mut a.dec, bytes)
			got = bytes.len
		}

		if ended {
			a.running = false
			return 0
		}

		total += got
		if total >= DRAIN_MAX {
			return 0
		}

		let w = tty.wait(files, 0) else |_| {
			return 0
		}

		if w.meaning != 0 || w.ready != 0 {
			return w.meaning
		}
	}
}

/// The editors quarry tries, in order: $VISUAL, $EDITOR, yew (PAX's), vi
fn editors() -> List[str] {
	var out = List[str]()
	let visual = env.get("VISUAL") else ""
	let editor = env.get("EDITOR") else ""

	if visual != "" {
		(mut out).push(visual)
	}

	if editor != "" {
		(mut out).push(editor)
	}

	(mut out).push("yew")
	(mut out).push("vi")

	out
}

/// Give the terminal to an editor on `path`, wait, and take it back, in yew's order.
fn hand_over(mut a: App, path: str) {
	let keyboard = signal.interrupt() | signal.quit()

	// 1. Stop hearing Ctrl-C and Ctrl-\: they belong to the child now.
	signal.ignore(keyboard) else |_| {}

	// 2. Give the terminal back: the main screen, the cursor, cooked mode.
	tty.leave(mut a.t)

	// 3. Start the child with OUR stdin (a child's is the null device
	// 	  unless mapped) and those two signals back at their defaults.
	var used = ""
	var status = 0
	for program in editors() {
		var c = process.command(program)
		process.push_arg(mut c, path)
		process.set_stdin(mut c, fs.stdin())

		var missing = false
		var child = process.start_job(c, -1, keyboard) else |_| {
			missing = true
			process.Child { slot: -1 }
		}
		if missing {
			continue	
		}

		// 4. Wait for it: the exit code, or -N for a death by signal N.
		status = process.wait_status(take child) else -1
		used = program
		break
	}

	// 5. Take the terminal back: the restore, the signals, raw mode, the
	// 	  alternate screen (enter's listen ends the ignore of step 1)/
	tty.enter(mut a.t) else |_| {
		a.running = false
		return 
	}

	// 6. The size may have changed and the screen certainly did; the file
	// 	  may have too.
	resized(mut a)
	reload(mut a, 0)
	reload(mut a, 1)

	if used == "" {
		say(mut a, "no editor could be started: set EDITOR")
	} else if status != 0 {
		say(mut a, "{used} exited with {status}")
	}
}

/// F4: edit the file under the cursor.
fn edit_file(mut a: App) {
	let i = a.active
	if a.panes[i].cursor >= a.panes[i].entries.len {
		return
	}

	if a.panes[i].entries[a.panes[i].cursor].to_dir {
		say(mut a, "that is a directory: Enter opens it")
		return
	}

	let path = pane.child_path(a.panes[i], a.panes[i].cursor) else |_| {
		say(mut a, "quarry cannot reach a name that is not UTF-8")
		return
	}

	hand_over(mut a, path)
}

/// The name under the active pane's cursor, for a message.
fn cursor_name(a: App) -> str {
	let p = a.panes[a.active]

	if p.cursor >= p.entries.len {
		return ""
	}

	pane.display_name(p, p.cursor)
}

/// Right: into the right pane, a slide, or a peek. A refusal is said on
/// the status line, and nothing moves.
fn go_right(mut a: App) {
	let from = a.active
	let to = nav.go_right(mut a.panes, mut a.view, from) else |e| {
		let name = cursor_name(a)

		match e {
			file => {
				say(mut a, "Enter opens {name} in your editor")
			},
			dangling => {
				say(mut a, "{name} points at nothing that is there")
			},
			utf8 => {
				say(mut a, "quarry cannot reach a name that is not UTF-8")
			}, 
			not_found => {
				say(mut a, "{name} is gone")
			},
			denied => {
				say(mut a, "cannot open {name}: denied")
			},
			io => {
				say(mut a, "cannot open {name}: io")
			},
		}

		from
	}

	a.active = to

	viewed(mut a)
}

/// Left: back into the left pane, or a slide the other way.
fn go_left(mut a: App) {
	let from = a.active
	let to = nav.go_left(mut a.panes, mut a.view, from) else |e| {
		match e {
			top => {
				say(mut a, "/ is the top")
			},
			not_found => {
				say(mut a, "the parent is gone")
			}, 
			denied => {
				say(mut a, "cannot open the parent: denied")
			},
			io => {
				say(mut a, "cannot open the parent: io")
			},
		}

		from
	}

	a.active = to
}

/// Tab: the cursor to the other pane, never a slide.
fn go_across(mut a: App) {
	let from = a.active
	if from == a.view.left {
		go_right(mut a)

		return
	}

	go_left(mut a)
}

/// Enter: a file opens in the editor; anything else is Right.
fn open(mut a: App) {
	if nav.under(a.panes[a.active]) == nav.ITEM_FILE {
		edit_file(mut a)

		return
	}

	go_right(mut a)
}



/// Pane `i`'s directory vanished: walk up and say where we landed.
fn recover(mut a: App, i: int) {
	if pane.recover(mut a.panes[i]) {
		say(mut a, "that directory is gone; now in {pane.path_of(a.panes[i])}")
	} else {
		say(mut a, "that directory is gone, and nothing above it can be listed")
	}
}

/// The right pane's directorty is gone: the view is made again when the
/// cursor rests, and a cursor in the right pane comes back to the left.
fn stale(mut a: App) {
	a.view.shows = nav.SHOWS_NOTHING
	(mut a.view.of).reset()

	if a.active != a.view.left {
		a.active = a.view.left
		say(mut a, "that directory is gone")
	}
}

/// Read pane `i` again. The right pane is a view: it is read only while
/// it is a listing, and when its directory has gone the view goes stale
/// instead of walking up.
fn reload(mut a: App, i: int) {
	let right = i != a.view.left
	if right && a.view.shows != nav.SHOWS_LISTING {
		return
	}

	pane.load(mut a.panes[i]) else |e| match e {
		not_found => {
			if right {
				stale(mut a)
			} else {
				recover(mut a, i)
			}
		},
		denied => {
			say(mut a, "cannot reload: denied")
		},
		io => {
			say(mut a, "cannot reload: io")
		},
	}
}

/// Once a second: reload a pane whose directory changed, and walk up
/// from one that vanished
fn poll_disk(mut a: App) {
	let now = now_ms()
	if now < a.next_poll_ms {
		return
	}

	a.next_poll_ms = now + POLL_MS

	let l = a.view.left
	let r = 1- l

	region scratch {
		let c = pane.changed(a.panes[l])
		if c == 1 {
			reload(mut a, l)
			a.dirty = true
		} else if c == 2 {
			recover(mut a, l)
			a.dirty = true
		}

		let d = if a.view.shows == nav.SHOWS_LISTING then pane.changed(a.panes[r]) else 0
		if d == 1 {
			reload(mut a, r)
			a.dirty = true
		} else if d == 2 {
			stale(mut a)
			a.dirty = true
		}
	}

	// A previewed file that changed is read again.
	viewed(mut a)
}

/// Keep the right pane on the item under the left cursor. When the
/// cursor has moved off the item the view was made for, wait until it
/// has rested for SETTLE_MS (`pressed` says a key came this turn, which
/// starts the wait again), then make the view once.
fn track(mut a: App, pressed: bool) {
	var current = true
	region scratch {
		current = nav.current(a.panes, a.view)
	}

	if current {
		a.due_ms = -1
		return
	}

	let now = now_ms()
	if pressed || a.due_ms < 0 {
		a.due_ms = now + SETTLE_MS
		return
	}

	if now < a.due_ms {
		return
	}

	region scratch {
		nav.follow(mut a.panes, mut a.view)
	}

	viewed(mut a)

	a.due_ms = -1
	a.dirty = true
}

/// When the right pane whows a file, find its preview in the cache, or
/// make it: one `stat` when the file is unchanged, one bounded read when 
/// it is new or changed. Called wherever the view may have changed.
fn viewed(mut a: App) {
	if a.view.shows != nav.SHOWS_FILE {
		return
	}

	let made = a.cache.made
	var at = a.shown

	region scratch {
		let path = str_from_utf8(a.view.of) else ""
		at = preview.look(mut a.cache, path)
	}

	if at != a.shown || a.cache.made != made {
		a.shown = at
		a.dirty = true
	}
}

/// Show or hide dot files, in both panes: the right one is a view
fn toggle_hidden(mut a: App) {
	let on = !a.panes[a.active].show_hidden
	a.panes[0].show_hidden = on
	a.panes[1].show_hidden = on
	reload(mut a, a.view.left)

	if a.view.shows == nav.SHOWS_LISTING {
		reload(mut a, 1 - a.view.left)
	}
}

/// Whether `name` can be a single file name: not empty, not `.` or
/// `..`, and no `/`.
fn valid_name(name: str) -> bool {
	if name == "" || name == "." || name == ".." {
		return false
	}

	for b in name.bytes() {
		if b as int == 47 || b as int == 0 {
			return false
		}
	}

	true
}

/// Whether anything is at `path`, a dangling link included.
fn present(path: str) -> bool {
	let _ = fs.lstat(path) else |_| {
		return false	
	}

	true
}

fn make_dir(mut a: App, name: str) {
	if !valid_name(name) {
		say(mut a, "not a file name: {name}")
		return
	}

	let path = fs.join(pane.path_of(a.panes[a.active]), name)

	fs.create_dir(path) else |e| {
		say(mut a, "cannot make {name}: {e}")
		return
	}

	reload(mut a, a.active)
	let _ = pane.cursor_to(mut a.panes[a.active], name)
}

fn rename(mut a: App, name: str) {
	let p = a.active
	let from = pane.child_path(a.panes[p], a.panes[p].cursor) else |_| {
		say(mut a, "quarry cannot reach a name that is not UTF-8")
		return
	}

	if !valid_name(name) {
		say(mut a, "not a file name: {name}")
		return
	}

	let to = fs.join(pane.path_of(a.panes[p]), name)

	if to == from {
		return
	}

	// move_file replaces what is there, quarry never does that silently
	if present(to) {
		say(mut a, "{name} already exists")
		return
	}
	fs.move_file(from, to) else |e| {
		say(mut a, "cannot rename: {e}")
		return
	}

	reload(mut a, p)
	let _ = pane.cursor_to(mut a.panes[p], name)
}

fn delete(mut a: App) {
	let p = a.active
	let t = pane.targets(a.panes[p])
	var gone = 0
	var failed = 0

	for i in t {
		let path = pane.child_path(a.panes[p], i) else ""
		if path == "" {
			failed += 1
			continue
		}

		let info = fs.lstat(path) else |_| {
			failed += 1
			continue
		}

		// lstat: a link to a directory is removed as a link, never followed.
		if info.kind == pane.KIND_DIR {
			fs.remove_dir_all(path) else |_| {
				failed += 1
				continue
			}
		} else {
			fs.remove(path) else |_| {
				failed += 1
				continue
			}
		}

		gone += 1
	}

	reload(mut a, 0)
	reload(mut a, 1)

	if failed > 0 {
		say(mut a, "deleted {gone}; {failed} could not be deleted")
	} else {
		say(mut a, "deleted {gone}")
	}
}

/// The dialog was accepted: do what it was opened for.
fn act(mut a: App) {
	let action = a.dlg.action
	let text = dialog.text_of(a.dlg)
	dialog.close(mut a.dlg)

	if action == ACT_MKDIR {
		make_dir(mut a, text)
	} else if action == ACT_RENAME {
		rename(mut a, text)
	} else if action == ACT_DELETE {
		delete(mut a)
	} else if action == ACT_STOP {
		job.cancel(mut a.copying)
		job.drop_all(mut a.queue)
		say(mut a, "stopping the copy")
	} else if action == ACT_QUIT {
		a.running = false
	}
}

/// Start the payload's copy into `dest`, in the background, or queue it
/// behind the copy that is running (the progress line counts the queue).
/// Answers false, having said why, when it can't.
fn start_copy(mut a: App, dest: str) -> bool {
	if a.copying.running {
		job.enqueue(mut a.queue, dest, paste.sources(a.payload))
		return true
	}
	let exe = os_exe() else |_| {
		say(mut a, "cannot find quarry's own program to start the copy")
		return false
	}
	job.start(mut a.copying, exe, dest, paste.sources(a.payload)) else |e| {
		say(mut a, "cannot start the copy: {e}")
		return false
	}
	true
}

/// F5: copy mode. The item under the cursor, or the marked ones, are the
/// payload, drawn sticky where they are; the cursor is the mobile cursor
/// from here on. Escape will come back to this spot.
fn enter_copy(mut a: App) {
	if paste.collect(mut a.payload, a.panes[a.active]) == 0 {
		if nav.under(a.panes[a.active]) == nav.ITEM_ODD {
			say(mut a, "quarry cannot reach a name that is not UTF-8")
		}
		return
	}
	nav.mark_spot(mut a.back_to, a.panes, a.view, a.active)
	a.copy_mode = true
}

/// Copy mode is over.
fn leave_copy(mut a: App) {
	a.copy_mode = false
	paste.clear(mut a.payload)
}

/// Escape (or `q`, or Ctrl-C) in copy mode: the mobile cursor goes, and
/// the sticky one is the cursor again, where copy mode began.
fn cancel_copy(mut a: App) {
	a.active = nav.go_to(mut a.panes, mut a.view, a.back_to, a.active)
	viewed(mut a)
	leave_copy(mut a)
	say(mut a, "copy cancelled")
}

/// What Enter would do from where the mobile cursor is, in words.
fn copy_hint(a: App) -> str {
	let c = paste.decide(a.payload, a.panes[a.active], a.active != a.view.left)
	paste.hint(a.payload, c)
}

/// Enter in copy mode: paste where the mobile cursor is, by `paste`'s
/// rules, or say why not and stay in copy mode. A paste into a directory
/// opens it in the right pane.
fn paste_here(mut a: App) {
	let p = a.active
	let c = paste.decide(a.payload, a.panes[p], p != a.view.left)
	if c.rule < 0 {
		say(mut a, paste.hint(a.payload, c))
		return
	}
	for src in paste.sources(a.payload) {
		if !present(src) {
			say(mut a, "{fs.file_name(src) else src} is gone")
			leave_copy(mut a)
			return
		}
	}
	if !start_copy(mut a, c.dest) {
		return
	}
	// When the copy is done, its directory's listing puts a cursor on it.
	(mut a.land).reset()
	for b in fs.join(c.dest, paste.name(a.payload, 0)).bytes() {
		(mut a.land).push(b)
	}
	var i = 0
	while i < 2 {
		if paste.shows(a.payload, a.panes[i]) {
			pane.clear_marks(mut a.panes[i])
		}
		i += 1
	}
	leave_copy(mut a)
	if c.rule == paste.INTO {
		a.active = nav.bring_left(mut a.panes, mut a.view, p)
	}
}

/// A key in copy mode. Answers true when copy mode took it: Enter,
/// Escape and `q`, and the keys that would act on files, which wait.
/// The rest (the arrows, Tab, `.`, Ctrl-R, F7, F10) do what they always
/// do, with the mobile cursor.
fn copy_key(mut a: App, k: keys.Key) -> bool {
	let c = k.code
	let plain = k.mods == 0
	if c == keys.K_ENTER {
		paste_here(mut a)
		return true
	}
	if c == keys.K_ESC || c == 113 && plain {
		cancel_copy(mut a)
		return true
	}
	let f = c - keys.K_F0
	let busy = f == 4 || f == 5 || f == 6 || f == 8 || c == keys.K_DEL || c == keys.K_INS
	if busy || plain && (c == 32 || c == 99 || c == 101) {
		say(mut a, "Enter pastes, Esc cancels")
		return true
	}
	false
}

/// The copy is done: the pane that shows its directory puts its cursor
/// on it, so the copy is under a cursor when you look.
fn land(mut a: App) {
	if a.land.len == 0 {
		return
	}
	let path = str_from_utf8(a.land) else ""
	let dir = fs.parent(path) else ""
	let name = fs.file_name(path) else ""
	let r = 1 - a.view.left
	if a.view.shows == nav.SHOWS_LISTING && pane.path_of(a.panes[r]) == dir {
		let _ = pane.cursor_to(mut a.panes[r], name)
	} else if pane.path_of(a.panes[a.view.left]) == dir {
		let _ = pane.cursor_to(mut a.panes[a.view.left], name)
	}
	(mut a.land).reset()
}

/// The worker ended: say how, remove what a cancel left behind, reload,
/// put a cursor on the copy, and start the next copy that waits.
fn finish_copy(mut a: App) {
	let removed = job.clean_up(mut a.copying)
	let first = str_from_utf8(a.copying.first) else ""
	let made = fs.file_name(str_from_utf8(a.copying.into) else "") else ""

	if a.copying.cancelled {
		if removed != "" {
			say(mut a, "copy cancelled; removed the partial {removed}")
		} else {
			say(mut a, "copy cancelled")
		}
	} else if a.copying.status != 0 {
		let why = str_from_utf8(a.copying.failure) else ""
		say(mut a, "copy failed: {why}")
	} else if made != "" && made != first {
		say(mut a, "copied {first} as {made}")
	} else {
		let n = a.copying.files
		let items = if n == 1 then "item" else "items"
		say(mut a, "copied {n} {items}, {pane.human_size(a.copying.bytes)}")
	}

	// The worker named the copy it made: that is where the cursor lands.
	if a.copying.into.len > 0 {
		(mut a.land).reset()

		for b in a.copying.into {
			(mut a.land).push(b)
		}
	}

	reload(mut a, 0)
	reload(mut a, 1)
	land(mut a)
	a.dirty = true
	next_copy(mut a)
}

/// Start the copy at the front of the queue, if one waits.
fn next_copy(mut a: App) {
	let next = job.dequeue(mut a.queue)
	if next.len < 2 {
		return
	}

	let exe = os_exe() else |_| {
		say(mut a, "cannot find quarry's own program to start the copy")
		return
	}

	job.start(mut a.copying, exe, next[0], next[1..next.len]) else |e| {
		say(mut a, "cannot start the next copy: {e}")
	}
}

/// `q`, F10 and Ctrl-C: quit, or, with a copy running, ask first.
fn quit(mut a: App) {
	if a.copying.running {
		dialog.ask(mut a.dlg, ACT_QUIT, "A copy is running: stop it and quit? (y/N)")
		return
	}

	a.running = false
}

/// Read the worker's pipe when it has something. `pipe` holds only the
/// pipe, so a key flood on stdin cannot hide it. Answers any meaning the
/// look took off the queue.
fn service_copy(mut a: App, pipe: List[fs.File]) -> int {
	let w = tty.wait(pipe, 0) else |_| {
		return 0
	}

	if w.ready == 0 {
		if job.pump(mut a.copying) {
			region scratch {
				finish_copy(mut a)
			}
		}

		a.dirty = true
	}

	w.meaning
}


/// The question F8 asks about pane `p`'s targets.
fn delete_question(p: pane.Pane) -> str {
	let t = pane.targets(p)

	if t.len == 1 {
		return "Delete {pane.display_name(p, t[0])}? (y/N)"
	}
	"Delete {t.len} marked items? (y/N)"
}

/// F8: ask first. The default answer is no.
fn ask_delete(mut a: App) {
	if pane.targets(a.panes[a.active]).len == 0 {
		return
	}

	dialog.ask(mut a.dlg, ACT_DELETE, delete_question(a.panes[a.active]))
}

/// F6: edit the name in place.
fn ask_rename(mut a: App) {
	let i = a.active
	if a.panes[i].cursor >= a.panes[i].entries.len {
		return
	}

	let name = pane.display_name(a.panes[i], a.panes[i].cursor)
	dialog.edit(mut a.dlg, ACT_RENAME, "Rename {name} to:", name)
}

/// One key changes the model, never the screen
fn on_key(mut a: App, k: keys.Key) {
	a.dirty = true

	if a.dlg.kind != dialog.NONE {
		let r = dialog.key(mut a.dlg, k)
		if r == dialog.ACCEPT {
			act(mut a)
		} else if r == dialog.CANCEL {
			dialog.close(mut a.dlg)
		}
		
		return
	}

	(mut a.status).reset()

	// Help is up: any key puts it away, and does nothing else.
	if a.help {
		a.help = false
		return
	}

	if k.code == 63 && k.mods == 0 || k.code == keys.K_F0 + 1 {
		a.help = true
		return
	}

	if a.copy_mode && copy_key(mut a, k) {
		return
	}
	let page = ui.list_rows(a.t.rows) - 1
	let c = k.code
	let plain = k.mods == 0

	if c == 113 && plain || c == keys.K_F0 + 10 {
		quit(mut a)
	} else if c == keys.K_DOWN {
		pane.move_by(mut a.panes[a.active], 1)
	} else if c == keys.K_UP {
		pane.move_by(mut a.panes[a.active], -1)
	} else if c == keys.K_PGDN {
		pane.move_by(mut a.panes[a.active], page)
	} else if c == keys.K_PGUP {
		pane.move_by(mut a.panes[a.active], 0 - page)
	} else if c == keys.K_HOME {
		a.panes[a.active].cursor = 0
	} else if c == keys.K_END {
		a.panes[a.active].cursor = a.panes[a.active].entries.len - 1
	} else if c == keys.K_RIGHT {
		go_right(mut a)
	} else if c == keys.K_ENTER {
		open(mut a)
	} else if c == keys.K_BACKSPACE || c == keys.K_LEFT {
		go_left(mut a)
	} else if c == keys.K_TAB {
		go_across(mut a)
	} else if c == 46 && plain {
		toggle_hidden(mut a)
	} else if c == 114 && k.mods == keys.MOD_CTRL {
		reload(mut a, 0)
		reload(mut a, 1)
	} else if c == keys.K_F0 + 7 {
		dialog.edit(mut a.dlg, ACT_MKDIR, "Make directory:", "")
	} else if c == keys.K_F0 + 6 {
		ask_rename(mut a)
	} else if c == keys.K_F0 + 8 || c == keys.K_DEL {
		ask_delete(mut a)
	} else if c == keys.K_F0 + 4 || c == 101 && plain {
		edit_file(mut a)
	} else if c == keys.K_F0 + 5 || c == 99 && plain {
		enter_copy(mut a)
	} else if c == keys.K_ESC && a.copying.running {
		dialog.ask(mut a.dlg, ACT_STOP, "Stop the copy? (y/N)")
	}

	 else if c == 32 && plain || c == keys.K_INS {
		pane.toggle_mark(mut a.panes[a.active])
		pane.move_by(mut a.panes[a.active], 1)
	}

	a.dirty = true
}

fn run(mut a: App) {
	var files = List[fs.File]()
	var pipe = List[fs.File]()
	var k = keys.Key { code: 0, mods: 0 }

	while a.running {
		if a.dirty {
			paint(mut a)
		}

		// The keyboard is file 0; a running copy's pipe is file 1.
		(mut files).reset()
		(mut pipe).reset()
		(mut files).push(fs.stdin())

		if a.copying.running {
			(mut files).push(a.copying.out)
			(mut pipe).push(a.copying.out)
		}

		let w = tty.wait(files, wait_ms(a)) else |_| {
			break
		}

		var meaning = w.meaning

		if w.ready == 0 {
			meaning = meaning | drain(mut a, files)
		}

		if a.copying.running {
			meaning = meaning | service_copy(mut a, pipe)
		}

		if meaning & signal.suspend() != 0 {
			tty.suspend(mut a.t) else |_| {
				break
			}

			resized(mut a)
		}

		if meaning & signal.resize() != 0 {
			resized(mut a)
		}
		// Ctrl-C closes an open dialog, leaves copy mode, or asks before
		// it stops a copy, instead of quitting.
		let busy = a.dlg.kind != dialog.NONE || a.copy_mode || a.copying.running
		if meaning & signal.interrupt() != 0 && busy {
			if a.dlg.kind != dialog.NONE {
				dialog.close(mut a.dlg)
			} else if a.copy_mode {
				region scratch {
					cancel_copy(mut a)
				}
			} else {
				quit(mut a)
			}
			meaning = meaning & !signal.interrupt()
			a.dirty = true
		}

		if meaning & !(signal.resize() | signal.suspend()) != 0 {
			break
		}

		poll_disk(mut a)
		var pressed = false
		while a.running && keys.next(mut a.dec, now_ms(), mut k) {
			pressed = true
			region scratch {
				on_key(mut a, k)
			}
		}
		
		track(mut a, pressed)
	}

	// Quitting with a copy running: stop it and tidy up after it.
	if a.copying.running {
		job.cancel(mut a.copying)
		while !job.pump(mut a.copying) {}
		let _ = job.clean_up(mut a.copying)
	}
}

/// The absolute path quarry starts a pane on: the argument, or the working
/// directory.
fn start_path(arg: str) -> str ! {not_found} {
	let p = if arg == "" then "." else arg
	fs.realpath(p) else |_| {
		return not_found
	}
}

fn main() -> !int {
	let args = env_args()
	if (args.get(0) else "") == "--worker" {
		return worker.main(args[1..args.len])
	}

	// One directory at most: the left pane's. The right pane is a view
	if args.len > 1 {
		eprint("usage: quarry [DIR]")
		return 2
	}

	let arg = args.get(0) else ""
	let path = start_path(arg) else |_| {
		eprint("quarry: no such directory: {arg}")
		return 1
	}

	var panes = List[pane.Pane]()
	(mut panes).push(pane.new(path))
	(mut panes).push(pane.new(path))

	pane.load(mut panes[0]) else |e| {
		eprint("quarry: cannot list {path}: {e}")
		return 1
	}

	var view = nav.start()
	nav.follow(mut panes, mut view)

	var t = tty.open() else |e| {
		eprint("quarry: standard input and output must be a terminal ({e})")
		return 1
	}

	tty.enter(mut t) else |_| {
		eprint("quarry: the terminal refused raw mode")
		return 1
	}

	var front = grid.new(t.rows, t.cols)
	grid.invalidate(mut front)
	let back = grid.new(t.rows, t.cols)

	var a = App {
		t: t,
		look: look_from_env(),
		front: front, 
		back: back,
		out: List[byte](), 
		dec: keys.new(),
		running: true, 
		dirty: true,
		panes: panes,
		active: 0,
		cache: preview.cache(),
		shown: -1,
		view: view,
		due_ms: -1,
		copy_mode: false,
		payload: paste.none(),
		back_to: nav.no_spot(),
		land: List[byte](),
		help: false,
		home: env.get("HOME") else "",
		status: List[byte](),
		next_poll_ms: now_ms() + POLL_MS,
		dlg: dialog.closed(),
		copying: job.idle(),
		queue: job.queue(),
	}

	viewed(mut a)
	run(mut a)
	tty.leave(mut a.t)

	0
}