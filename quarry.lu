//! member: false
//! quarry, step 4: the loop that never lags. One wait over the keyboard,
//! signals and the ESC deadline; ALL waiting input is drained and applied
//! before ONE frame is drawn; drawing, rendering and reading happen in a
//! region that dies at the end of each turn

use grid
use keys
use std.env
use std.fs
use std.signal
use std.time
use tty

/// The longest input quarry drains in one turn before it draws.
const DRAIN_MAX: int = 262144

/// Everything the program knows
struct App {
	t: tty.Tty, 
	look: grid.Look,
	front: grid.Grid,
	back: grid.Grid,
	out: List[byte],
	dec: keys.Decoder,
	running: bool,
	dirty: bool,
	bar: int,
	last_bytes: int,
	last_frame_us: int,
	keys_last_turn: int,
}


/// Box drawing unless the terminal is dumb, color unless NO_COLOR.
fn look_from_env() -> grid.Look {
	let term = env.get("TERM") else ""
	let no_color = env.get("NO_COLOR") else ""
	let gl = if term == "" || term == "dumb" then grid.ascii_glyphs() else grid.box_glyphs()

	grid.Look { gl: gl, color: no_color == "" && term != "dumb" }
}

fn now_ms() -> int {
	time.monotonic_ns() / 1000000
}

/// Draw the whole screen into the back grid. Pure: no I/O.
fn draw(mut g: grid.Grid, look: grid.Look, bar: int, bytes: int, us: int, keys_seen: int) {
	grid.clear(mut g)
	let half = g.cols / 2
	let h = g.rows - 1

	grid.frame(mut g, 0, 0, h, half, look.gl, grid.DEFAULT)
	grid.frame(mut g, 0, half, h, g.cols - half, look.gl, grid.DEFAULT)

	var row = 1
	while row < h -1 {
		let attr = if row - 1 == bar then grid.ATTR_REVERSE else 0


		grid.fill(mut g, row, 1, half - 2, 32, grid.DEFAULT, grid.DEFAULT, attr)
		let _ = grid.puts(
			mut g,
			row,
			2,
			half - 4,
			"entry {row - 1}",
			grid.DEFAULT,
			grid.DEFAULT,
			attr,
		)

		row += 1
	}

	let status = " frame {bytes} B in {us} us, {keys_seen} keys last turn   q quits"
	let _ = grid.puts(mut g, g.rows - 1, 0, g.cols - 1, status, grid.DEFAULT, grid.DEFAULT, 0)
}

/// Draw, diff, write once. The strings built while drawing and the
/// escape sequences built while rendering die with the region.
fn paint(mut a: App) {
	let t0 = time.monotonic_ns()
	(mut a.out).reset()

	region scratch {
		draw(mut a.back, a.look, a.bar, a.last_bytes, a.last_frame_us, a.keys_last_turn)
		a.last_bytes = grid.render(a.front, a.back, mut a.out)
	}

	tty.write(a.out) else |_| {
		a.running = false
	}

	grid.assign(mut a.front, a.back)
	a.last_frame_us = (time.monotonic_ns() - t0) / 1000
	a.dirty = false
}

/// How long the wait may sleep: until the ESC deadline, or forever.
fn wait_ms(a: App) -> int {
	let due = keys.deadline(a.dec)

	if due < 0 {
		return -1
	}

	let now = now_ms()
	if due > now then due - now else 0
}

/// The window changed size: new grids, everything redrawn.
fn resized(mut a: App) {
	tty.refresh_size(mut a.t)
	grid.resize(mut a.front, a.t.rows, a.t.cols)
	grid.invalidate(mut a.front)
	grid.resize(mut a.back, a.t.rows, a.t.cols)
	a.dirty = true
}

/// Read everything waiting on stdin into the decoder: read, then look
/// again without sleeping, until nothing is left (or DRAIN_MAX). A 
/// signal meaning seen while looking is handed back, never dropped.
fn drain(mut a: App, files: List[fs.File]) -> int {
	var total = 0
	loop {
		var got = 0
		var ended = false
		region scratch {
			let bytes = tty.read(4096) else |_| {
				List[byte]()
			}

			if bytes.len == 0 {
				ended = true
			}

			keys.feed(mut a.dec, bytes)
			got = bytes.len
		}

		if ended {
			a.running = false
			return 0
		}

		total += got
		if total >= DRAIN_MAX {
			return 0
		}

		let w = tty.wait(files, 0) else |_| {
			return 0
		}

		if w.meaning != 0 || w.ready != 0 {
			return w.meaning
		}
	}
}

/// One key changes the model, never the screen
fn on_key(mut a: App, k: keys.Key) {
	if k.code == 113 && k.mods == 0 {
		a.running = false
	} else if k.code == keys.K_DOWN && a.bar < a.t.rows - 4 {
		a.bar += 1
	} else if k.code == keys.K_UP && a.bar > 0 {
		a.bar -= 1
	} else if k.code == keys.K_HOME {
		a.bar = 0
	} else if k.code == keys.K_END {
		a.bar = a.t.rows - 4
	}
	a.dirty = true
}

fn run(mut a: App) {
	var files = List[fs.File]()
	(mut files).push(fs.stdin())
	var k = keys.Key { code: 0, mods: 0 }

	while a.running {
		if a.dirty {
			paint(mut a)
		}

		let w = tty.wait(files, wait_ms(a)) else |_| {
			break
		}

		var meaning = w.meaning

		if w.ready == 0 {
			meaning = meaning | drain(mut a, files)
		}

		if meaning & signal.resize() != 0 {
			resized(mut a)
		}

		if meaning & !signal.resize() != 0 {
			break
		}

		var n = 0
		while keys.next(mut a.dec, now_ms(), mut k) {
			on_key(mut a, k)

			n += 1
		}

		if n > 0 {
			a.keys_last_turn = n
		}
	}
}





fn main() -> !int {
	var t = tty.open() else |e| {
		eprint("quarry: standard input and output must be a terminal ({e})")
		return 1
	}

	tty.enter(mut t) else |_| {
		eprint("quarry: the terminal refused raw mode")
		return 1
	}

	var front = grid.new(t.rows, t.cols)
	grid.invalidate(mut front)
	let back = grid.new(t.rows, t.cols)

	var a = App {
		t: t,
		look: look_from_env(),
		front: front, 
		back: back,
		out: List[byte](), 
		dec: keys.new(),
		running: true, 
		dirty: true,
		bar: 0,
		last_bytes: 0,
		last_frame_us: 0,
		keys_last_turn: 0,
	}

	run(mut a)
	tty.leave(mut a.t)

	0
}