//! member: false
//! quarry, step 2: keys, not bytes. The same terminal contract as step 1,
//! but every key is printed by name

use keys
use std.fs
use std.signal
use std.time
use tty

fn say(line: str) {
	var b = List[byte]()

	for x in line.bytes() {
		(mut b).push(x)
	}

	(mut b).push(13 as byte)
	(mut b).push(10 as byte)

	tty.write(b) else |_| {}
}




fn main() -> !int {
	var t = tty.open() else |e| {
		eprint("quarry: standard input and output must be a terminal ({e})")
		return 1
	}

	tty.enter(mut t) else |_| {
		eprint("quarry: the terminal refused raw mode")
		return 1
	}

	say("quarry: {t.cols}x{t.rows}.Press keys; q quits.")
	var files = List[fs.File]()
	(mut files).push(fs.stdin())
	var dec = keys.new()
	var k = keys.Key { code: 0, mods: 0 }
	var running = true

	while running {
		// Sleep until a key, a signal, or the lone-ESC deadline.
		let now = time.monotonic_ns() / 1000000
		let due = keys.deadline(dec)
		let wait_ms = if due < 0 then -1 else if due > now then due - now else 0

		let w = tty.wait(files, wait_ms) else |_| {
			break
		}

		if w.meaning != 0 {
			if w.meaning & signal.resize() != 0 {
				tty.refresh_size(mut t)
				say("resized: {t.cols}x{t.rows}")
				continue
			}
			
			break
		}

		if w.ready == 0 {
			let bytes = tty.read(256) else |_| {
				break
			}

			keys.feed(mut dec, bytes)
		}

		while keys.next(mut dec, time.monotonic_ns() / 1000000, mut k) {
			say(keys.name(k))
			if k.code == 113 && k.mods == 0 {
				running = false
			}
		}
	}

	tty.leave(mut t)

	0
}