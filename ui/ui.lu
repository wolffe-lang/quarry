//! ui: draws the model into the back grid. Nothing here touches the 
//! terminal or the file system, and quarry calls it inside the frame's
//! scratch region, so every string built here dies with the frame.

use job
use dialog
use grid
use pane
use paste
use preview
use std.time

/// Color 4 of the 16: blue. Add 8 to any color for its bright twin
pub const BLUE: int = 4

/// Color 6 of the 16: cyan.
pub const CYAN: int = 6

/// Color 2 of the 16: green
pub const GREEN: int = 2

/// Color 3 of the 16: yellow.
pub const YELLOW: int = 3

/// Color 1 of the 16: red.
pub const RED: int = 1

/// Color 5 of the 16: magenta, copy mode's sticky rows.
pub const MAGENTA: int = 5

/// Color 0 of the 16: black.
pub const BLACK: int = 0

/// Color 7 of the 16: white (light grey on most terminals)
pub const WHITE: int = 7

/// Color 8 of the 16: bright black, which most terminals dray grey.
pub const GREY: int = 8

/// The narrowest screen quarry draws panes on.
pub const MIN_COLS: int = 40

/// The shortest screen quarry draws panes on.
pub const MIN_ROWS: int = 10

/// Rows the panes leave for entries on a screen `rows` tall: the frame
/// takes two, the status line and the key bar one each.
pub fn list_rows(rows: int) -> int {
	rows - 4
}

/// `c` when the look has color, else the terminal's default.
pub fn col(look: grid.Look, c: int) -> int {
	if look.color then c else grid.DEFAULT
}

/// Screen cells `s` takes: one per code poinbt (the PAX console's rule)
pub fn cells(s: str) -> int {
	var n = 0
	for b in s.bytes() {
		if b as int & 192 != 128 {
			n += 1
		}
	}

	n
}

/// The byte offset of code point `k` in `s` (its length past the end).
fn byte_offset(s: str, k: int) -> int {
	var seen = 0
	var i = 0

	for b in s.bytes() {
		if b as int & 192 != 128 {
			if seen == k {
				return i
			}

			seen += 1
		}

		i += 1
	}

	s.len
}

/// The first `n` code points of `s`
pub fn head(s: str, n: int) -> str {
	s.get(0..byte_offset(s, n)) else ""
}

/// The last `n` code points of `s`
pub fn tail(s: str, n: int) -> str {
	let total = cells(s)

	if n >= total {
		return s
	}

	s.get(byte_offset(s, total - n)..s.len) else ""
}

/// `s` in at most `w` cells: a long name keeps its start and its end
/// with `~` between them, as Midnight Commander shows one.
pub fn fit(s: str, w: int) -> str {
	if cells(s) <= w {
		return s
	}

	if w < 3 {
		return head(s, w)
	}

	let keep = w - 1
	head(s, keep - keep / 2) + "~" + tail(s, keep  / 2)
}

/// `path` with the home directory written `~`, cut from the left to `w`
/// cells when it is still too long.
pub fn short_path(path: str, home: str, w: int) -> str {
	var p = path
	if home.len > 1 && path == home {
		p = "~"
	} else if home.len > 1 && path.starts_with(home + "/") {
		p = "~" + (path.get(home.len..path.len) else "")
	}

	if cells(p) <= w {
		return p
	}

	if w < 4 {
		return tail(p, w)
	}

	"..." + tail(p, w - 3)
}

fn is_exec(e: pane.Entry) -> bool {
	e.kind == pane.KIND_FILE && e.mode & 73 != 0
}

/// The color and attribute an entry is drawn in, and the one-letter
/// mark `ls -F` puts after it.
fn style(look: grid.Look, e: pane.Entry) -> (int, int, str) {
	if e.marked {
		return (col(look, YELLOW + 8), grid.ATTR_BOLD, if e.to_dir then "/" else "")
	}

	if e.kind == pane.KIND_LINK {
		return (col(look, CYAN + 8), 0, if e.to_dir then "@/" else "@")
	}

	if e.to_dir {
		return (col(look, BLUE + 8), grid.ATTR_BOLD, "/")
	}

	if is_exec(e) {
		return (col(look, GREEN + 8), 0, "*")
	}

	// `ls -F`'s marks for a fifo and a socket, which a preview never opens.
	if e.kind == 4 {
		return (grid.DEFAULT, 0, "|")
	}

	if e.kind == 5 {
		return (grid.DEFAULT, 0, "=")
	}

	(grid.DEFAULT, 0, "")
}

/// What the size column says for an entry.
fn size_text(e: pane.Entry) -> str {
	if e.to_dir {
		return "<DIR>"
	}

	pane.human_size(e.size)
}

fn ghost_mark(look: grid.Look) -> int {
	if look.gl.h == 45 then 62 else 187
}

/// Entry `i` of `p` on screen row `row` of a pane's box at column
/// `left`, `width` wide: `gutter` (32, a space, or a mark) in the column
/// before the name, the name with its `ls -F` mark, and the size, all in
/// the colors and attribute given.
fn draw_entry(
	mut g: grid.Grid,
	look: grid.Look,
	p: pane.Pane,
	i: int,
	row: int,
	left: int,
	width: int, 
	fg: int,
	bg: int,
	attr: int,
	gutter: int,
) {
	let inner = width - 2
	let size_w = 6
	let name_w = inner - size_w - 2
	let e = copy p.entries[i]
	let (_, _, mark) = style(look, e)

	// A plain row leaves the blanks blank, so the renderer can erase the
	// rest of a line in one sequence; a bar or a mark fills the row.
	if bg != grid.DEFAULT || attr & grid.ATTR_REVERSE != 0 || gutter != 32 {
		grid.fill(mut g, row, left + 1, inner, 32, fg, bg, attr)
		grid.put(mut g, row, left + 1, gutter, fg, bg, attr | grid.ATTR_BOLD)
	}

	let name = fit(pane.display_name(p, i) + mark, name_w)
	let _ = grid.puts(mut g, row, left + 2, name_w, name, fg, bg, attr)
	let size = size_text(e)
	let at = left + 1 + inner - 1 - cells(size)
	let _ = grid.puts(mut g, row, at, size_w, size, fg, bg, attr)
}

fn draw_pane(
	mut g: grid.Grid,
	look: grid.Look,
	p: pane.Pane,
	left: int, 
	width: int,
	height: int,
	active: bool,
	ghost: bool,
	home: str,
) {
	let edge = if active then col(look, CYAN + 8) else grid.DEFAULT
	grid.frame(mut g, 0, left, height, width, look.gl, edge)
	let title = " " + short_path(pane.path_of(p), home, width - 6) + " "
	let _ = grid.puts(
		mut g, 
		0,
		left + 2,
		width - 4,
		title, 
		edge,
		grid.DEFAULT,
		if active then grid.ATTR_REVERSE else grid.ATTR_BOLD,
	)
	
	let inner = width - 2

	if p.entries.len == 0 {
		// An empty pane can still hold the cursor: it waits on the note.
		let attr = if active then grid.ATTR_REVERSE else 0

		if active {
			grid.fill(mut g, 1, left + 1, inner, 32, grid.DEFAULT, grid.DEFAULT, attr)
		}

		let _ = grid.puts(
			mut g,
			1,
			left + 2,
			inner - 2,
			"(empty)",
			grid.DEFAULT,
			grid.DEFAULT,
			attr,
		)
		
		return
	}

	var r = 0
	while r < height - 2 && p.top + r < p.entries.len {
		let i = p.top + r
		let e = copy p.entries[i]
		let (fg, base, _) = style(look, e)
		let on = active && i == p.cursor
		let shade = ghost && i == p.cursor
		let attr = if on then base | grid.ATTR_REVERSE else base
		let bg = if shade then col(look, GREY) else grid.DEFAULT
		let gutter = if shade then ghost_mark(look) else 32
		draw_entry(mut g, look, p, i, r + 1, left, width, fg, bg, attr, gutter)

		r += 1
	}
}

/// The status line for the entry under the active pane's cursor: what
/// `ls -l` would say , with the time in the local zone
pub fn describe(p: pane.Pane) -> str {
	if p.cursor >= p.entries.len {
		return ""
	}

	let e = copy p.entries[p.cursor]
	var stamp = "-"

	if e.mtime_s != 0 {
		let l = time.local(e.mtime_s) else |_| {
			return "{pane.mode_string(e.kind, e.mode)}  {pane.human_size(e.size)}"
		}

		stamp = time.format(l, "%Y-%m-%d %H:%M") else "-"
	}

	"{pane.mode_string(e.kind, e.mode)}  {pane.human_size(e.size)}  {stamp}  {pane.display_name(p, p.cursor)}"
}

/// Draw both panes, the status line and the key bar. `active` is the
/// pane with the cursor; `status` replaces the entry's description when
/// it is not empty; `keybar` is the last row.
pub fn draw(
	mut g: grid.Grid,
	look: grid.Look,
	left: pane.Pane,
	right: pane.Pane,
	active: int,
	home: str,
	status: str, 
	keybar: str,
) {
	grid.clear(mut g)
	if g.cols < MIN_COLS || g.rows < MIN_ROWS {
		// One line, clipped like every other: nothing can index outside
		let msg = "quarry needs {MIN_COLS}x{MIN_ROWS}; this is {g.cols}x{g.rows}"
		let _ = grid.puts(mut g, 0, 0, g.cols, msg, grid.DEFAULT, grid.DEFAULT, grid.ATTR_BOLD)

		return
	}

	let height = g.rows - 2
	let half = g.cols / 2

	draw_pane(mut g, look, left, 0, half, height, active == 0, active == 1,  home)
	draw_pane(mut g, look, right, half, g.cols - half, height, active == 1, false, home)

	let row = g.rows - 2

	if status.len > 0 {
		let _ = grid.puts(
			mut g,
			row, 
			1,
			g.cols - 2,
			status, 
			col(look, YELLOW + 8),
			grid.DEFAULT,
			grid.ATTR_BOLD
		)
	} else {
		let text = if active == 0 then describe(left) else describe(right)
		let _ = grid.puts(mut g, row, 1, g.cols - 2, text, grid.DEFAULT, grid.DEFAULT, 0)
	}

	// The key bar: black on cyan, or reverse video without color
	let bar = g.rows - 1
	let bar_attr = if look.color then 0 else grid.ATTR_REVERSE
	grid.fill(mut g, bar, 0, g.cols, 32, col(look, BLACK), col(look, CYAN), bar_attr)
	let _ = grid.puts(mut g, bar, 0, g.cols, keybar, col(look, BLACK), col(look, CYAN), bar_attr)
}

/// Draw the open dialog over the panes: a framed box in the middle, the
/// question or title, and for an input line the text with its cursor
pub fn draw_dialog(mut g: grid.Grid, look: grid.Look, d: dialog.Dialog) {
	let title = dialog.title_of(d)
	var w = cells(title)  + 6

	if w < 44 {
		w = 44
	}

	if w > g.cols - 2 {
		w = g.cols - 2
	}

	let h = if d.kind == dialog.INPUT then 5 else 4
	let top = (g.rows - h) / 2
	let left = (g.cols - w) / 2
	var r = top

	while r < top + h {
		grid.fill(mut g, r, left, w, 32, grid.DEFAULT, grid.DEFAULT, 0)

		r += 1
	}

	let edge = col(look, YELLOW + 8)
	grid.frame(mut g, top, left, h, w, look.gl, edge)
	let room = w - 4

	let _ = grid.puts(
		mut g,
		top + 1,
		left + 2,
		room, 
		fit(title, room),
		grid.DEFAULT,
		grid.DEFAULT,
		grid.ATTR_BOLD
	)

	if d.kind == dialog.INPUT {
		// Scroll the text so the cursor is always inside the box.
		let first = if d.at >= room then d.at - room + 1 else 0
		let shown = dialog.slice(d, first, first + room)

		grid.fill(
			mut g,
			top + 2,
			left + 2,
			room, 
			32,
			grid.DEFAULT,
			grid.DEFAULT,
			grid.ATTR_UNDERLINE,
		)

		let _ = grid.puts(
			mut g,
			top + 2,
			left + 2,
			room, 
			shown, 
			grid.DEFAULT, 
			grid.DEFAULT,
			grid.ATTR_UNDERLINE,
		)

		let at = left + 2 + d.at - first
		let under = grid.cell_at(g, top + 2, at)

		grid.put(mut g, top + 2, at, under.cp, grid.DEFAULT, grid.DEFAULT, grid.ATTR_REVERSE)

		let _ = grid.puts(
			mut g, 
			top + 3,
			left + 2,
			room,
			"Enter OK   Esc cancel",
			grid.DEFAULT,
			grid.DEFAULT,
			0
		)
	} else {
		let _ = grid.puts(
			mut g,
			top + 2,
			left + 2,
			room, 
			"y yes   any other key no",
			grid.DEFAULT,
			grid.DEFAULT,
			0,
		)
	}
}

/// The status line while a copy runs: how far, as a bar and in numbers,
/// and how many copies wait behind it.
pub fn draw_progress(mut g: grid.Grid, look: grid.Look, j: job.Job, waiting: int) {
	if g.cols < MIN_COLS || g.rows < MIN_ROWS {
		return
	}

	let row = g.rows - 2

	grid.fill(mut g, row, 0, g.cols, 32, grid.DEFAULT, grid.DEFAULT, 0)

	let pm = job.permille(j)
	let label = " Copy {j.files}/{j.total_files} "
	let more = if waiting > 0 then "  {waiting} waiting" else ""
	let numbers = " {pm / 10}% {pane.human_size(j.bytes)} of {pane.human_size(j.total_bytes)}{more}  Esc stops"
	var c = 1

	c += grid.puts(
		mut g,
		row,
		c,
		cells(label),
		label,
		col(look, CYAN + 8),
		grid.DEFAULT, 
		grid.ATTR_BOLD,
	)

	let bar_w = g.cols - 1 - c - cells(numbers) - 2
	if bar_w >= 4 {
		// PAX's font has the full block (U+2588); an ASCOO look gets '#'.
		let full = if look.gl.h == 45 then 35 else 9608
		let filled = bar_w * pm / 1000

		grid.put(mut g, row, c, 91, grid.DEFAULT, grid.DEFAULT, 0)
		grid.fill(mut g, row, c + 1, filled, full, col(look, GREEN + 8), grid.DEFAULT, 0)
		grid.fill(mut g, row, c + 1 + filled, bar_w - filled, 46, grid.DEFAULT, grid.DEFAULT, 0)
		grid.put(mut g, row, c + 1 + bar_w, 93, grid.DEFAULT, grid.DEFAULT, 0)

		c += bar_w + 2
	}

	let _ = grid.puts(mut g, row, c, g.cols - c, numbers, grid.DEFAULT, grid.DEFAULT, 0)
}

/// An empty box where the right pane goes, framed and titled as a pane
/// without the cursor is. Answers the box's left column.
fn right_box(mut g: grid.Grid, look: grid.Look, path: str, home: str) -> int {
	let left = g.cols / 2
	let width = g.cols - left
	let height = g.rows - 2

	var r = 0
	while r < height {
		grid.fill(mut g, r, left, width, 32, grid.DEFAULT, grid.DEFAULT, 0)

		r += 1
	}

	grid.frame(mut g, 0, left, height, width, look.gl, grid.DEFAULT)

	if path != "" {
		let title = " " + short_path(path, home, width - 6) + " "
		let _ = grid.puts(
			mut g,
			0,
			left + 2,
			width - 4,
			title,
			grid.DEFAULT,
			grid.DEFAULT,
			grid.ATTR_BOLD
		)
	}

	left
}

/// The right pane when it is not not a listing: the path of what is under
/// the left cursor as its title, and a note, wrapped at its spaces.
/// Drawn over what `draw` put there.
pub fn draw_note(mut g: grid.Grid, look: grid.Look, path: str, note: str, home: str) {
	if g.cols < MIN_COLS || g.rows < MIN_ROWS {
		return 
	}

	let left = right_box(mut g, look, path, home)
	let w = g.cols - left - 4
	var row = 1
	var line = ""

	for word in note.words() {
		if line != "" && cells(line) + 1 + cells(word) > w {
			if row < g.rows - 3 {
				let _ = grid.puts(
					mut g, 
					row,
					left + 2,
					w,
					fit(line, w),
					grid.DEFAULT,
					grid.DEFAULT,
					0,
				)
			}

			row += 1
			line = ""
		}

		line = if line == "" then word else line + " " + word
	}

	if line != "" && row < g.rows - 3 {
		let _ = grid.puts(mut g, row, left + 2,w, fit(line, w), grid.DEFAULT, grid.DEFAULT, 0)
	}
}

/// The right pane as the preview of a file: its first lines, its 
/// summary and hex, or its note. Drawn over what `draw` put there, as
/// `draw_note` is. Lines are clipped at the frame, never wrapped.
pub fn draw_preview(mut g: grid.Grid, look: grid.Look, pv: preview.Preview, home: str) {
	if g.cols < MIN_COLS || g.rows < MIN_ROWS {
		return
	}

	let path = str_from_utf8(pv.path) else ""
	let note = str_from_utf8(pv.note) else ""

	if pv.kind == preview.NOTE {
		draw_note(mut g, look, path, note, home)

		return
	}

	let left = right_box(mut g, look, path, home)
	let w = g.cols - left - 4
	let rows = g.rows - 4

	if pv.kind == preview.TEXT {
		var i = 0 
		while i < rows && i < preview.lines(pv) {
			let text = preview.line(pv, i)
			let _ = grid.puts(mut g, i + 1, left + 2, w, text, grid.DEFAULT, grid.DEFAULT, 0)

			i += 1
		}

		return
	}

	let _ = grid.puts(
		mut g, 
		1, 
		left + 2,
		w, 
		fit(note, w),
		grid.DEFAULT, 
		grid.DEFAULT,
		grid.ATTR_BOLD,
	)

	let per = preview.per_row(w)

	var r = 0
	while r + 3 <= rows && r < preview.hex_rows(pv, per) && r < preview.HEX_ROWS {
		let row = preview.hex_row(pv, r, per)
		let _ = grid.puts(mut g, r + 3, left + 2, w, row, grid.DEFAULT, grid.DEFAULT, 0)

		r += 1
	}
}

/// In copy mode, the rows being copied, over what `draw` put there: black
/// on magenta with `+` in the gutter, in the pane on `side` (0, left, 1,
/// right) when it lists the payload's directory. The mobile cursor,
/// passing under one, is hidden behind it.
pub fn draw_sticky(mut g: grid.Grid, look: grid.Look, p: pane.Pane, side: int, pl: paste.Payload) {
	if g.cols < MIN_COLS || g.rows < MIN_ROWS || !paste.shows(pl, p) {
		return
	}

	let half = g.cols / 2
	let left = if side == 0 then 0 else half
	let width = if side == 0 then half else g.cols - half

	var r = 0
	while r < g.rows - 4 && p.top + r < p.entries.len {
		let i = p.top + r

		if paste.holds(pl, p, i) {
			draw_entry(
				mut g, 
				look, 
				p, 
				i,
				r + 1,
				left,
				width,
				col(look, BLACK),
				col(look, MAGENTA),
				0, 
				43,
			)
		}

		r += 1
	}
}

/// The key table that `?` and F1 show.
fn help_lines() -> List[str] {
	[
		"quarry's keys",
		"",
		"Up Down PgUp PgDn Home End   move the cursor",
		"Right    into the right pane; at its edge, slide",
		"Left     back into the left pane; there, slide back",
		"Enter    a directory: as Right. A file: edit it",
		"Tab      the cursor across    Backspace  as Left",
		"F4 e     edit                 F5 c       copy mode",
		"F6       rename               F7         make a directory",
		"F8 Del   delete               Space Ins  mark",
		".        dot files            Ctrl-R     read again",
		"Esc      stop a copy          q F10      quit",
		"",
		"In copy mode the arrows move the mobile cursor,",
		"Enter pastes, and Esc goes back to where you began.",
		"",
		"Any key closes this.",
	]
}

/// Help, over everything else: the key table in a framed box in the
/// middle of the screen, clipped like every other drawing.
pub fn draw_help(mut g: grid.Grid, look: grid.Look) {
	let lines = help_lines()

	var w = 0
	for l in lines {
		if cells(l) > w {
			w = cells(l)
		}
	}

	w += 4
	if w > g.cols {
		w = g.cols
	}

	var h = lines.len + 2
	if h > g.rows {
		h = g.rows
	}

	let top = (g.rows - h) / 2
	let left = (g.cols - w) / 2

	var r = 0
	while r < h {
		grid.fill(mut g, top + r, left, w, 32, grid.DEFAULT, grid.DEFAULT, 0)

		r += 1
	}

	grid.frame(mut g, top, left, h, w, look.gl, col(look, CYAN + 8))

	var i = 0
	while i < lines.len && i < h - 2 {
		let attr = if i == 0 then grid.ATTR_BOLD else 0
		let _ = grid.puts(
			mut g,
			top + 1 + i,
			left + 2,
			w - 4,
			lines[i],
			grid.DEFAULT,
			grid.DEFAULT,
			attr,
		)

		i += 1
	}
}



