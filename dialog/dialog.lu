//! dialog: a yes/no question and a one-line editor, as data. A dialog
//! takes keys and says when it is finished; quarry decided what happens then

use keys

/// No dialog is open
pub const NONE: int = 0

/// A yes/no question: `y` answers yes, any other key no.
pub const CONFIRM: int = 1

/// `keys`'s answer: accepted (Enter, or `y` to a question).
pub const ACCEPT: int = 1

/// `key`'s answer: cancelled (Escape, or anything but `y` to a question).
pub const CANCEL: int = 2

/// One dialog. quarry keeps one and reopens it, so its lists are reused.
pub struct Dialog {
	kind: int,
	action: int,
	title: List[byte],
	text: List[int],
	at: int
}

/// A closed dialog.
pub fn closed() -> Dialog {
	Dialog { kind: NONE, action: 0, title: List[byte](), text: List[int](), at: 0 }
}

fn set_title(mut d: Dialog, title: str) {
	(mut d.title).reset()
	for b in title.bytes() {
		(mut d.title).push(b)
	}
}

/// Ask a yes/no question. `action` is quarry's number for what to do on yes.
pub fn ask(mut d: Dialog, action: int, question: str) {
	d.kind = CONFIRM
	d.action = action

	set_title(mut d, question)
	(mut d.text).reset()

	d.at = 0
}

/// Edit a line, starting from `initial` with the cursor at its end. 
pub fn edit(mut d: Dialog, action: int, title: str, initial: str) {
	d.kind = INPUT
	d.action = action

	set_title(mut d, title)
	(mut d.text).reset()

	for ch in initial.chars() {
		(mut d.text).push(ch as int)
	}

	d.at = d.text.len
}

/// Close the dialog
pub fn close(mut d: Dialog) {
	d.kind = NONE
}

fn insert(mut d: Dialog, cp: int) {
	(mut d.text).push(0)

	var i = d.text.len - 1
	while i > d.at {
		d.text[i] = d.text[i - 1]

		i -= 1
	}
	
	d.text[d.at] = cp
	d.at += 1
}

fn remove_at(mut d: Dialog, i: int) {
	if i < 0 || i >= d.text.len {
		return
	}

	var j = i
	while j < d.text.len - 1 {
		d.text[j] = d.text[j + 1]

		j += 1
	}

	let _ = (mut d.text).pop() else 0
}

/// Apply one key. Answers OPEN, ACCEPT or CANCEL.
pub fn key(mut d: Dialog, k: keys.Key) -> int {
	let c = k.code

	if d.kind == CONFIRM {
		return if (c == 121 || c == 89) && k.mods & keys.MOD_CTRL == 0 then ACCEPT else CANCEL
	}

	if c == keys.K_ENTER {
		return ACCEPT
	}

	if c == keys.K_ESC {
		return CANCEL
	}

	if c == keys.K_LEFT && d.at > 0 {
		d.at -= 1
	} else if c == keys.K_RIGHT && d.at < d.text.len {
		d.at += 1
	} else if c == keys.K_HOME || c == 97 && k.mods == keys.MOD_CTRL {
		d.at = 0
	} else if c == keys.K_END || c == 101 && k.mods == keys.MOD_CTRL {
		d.at = d.text.len
	} else if c == keys.K_BACKSPACE && d.at > 0 {
		remove_at(mut d, d.at - 1)
		d.at -= 1
	} else if c == keys.K_DEL {
		remove_at(mut d, d.at)
	} else if c == 117 && k.mods == keys.MOD_CTRL {
		// Ctrl-U: delete everything before the cursor, as a shell does.
		while d.at > 0 {
			remove_at(mut d, 0)
			d.at -= 1
		}
	} else if c >= 32 && c < keys.KEY_BASE && k.mods & (keys.MOD_CTRL | keys.MOD_ALT) == 0 {
		insert(mut d, c)
	}

	OPEN
}

/// Append the UTF-8 bytes of scalar `cp`.
pub fn push_utf8(mut b: List[byte], cp: int) {
	if cp < 128 {
		(mut b).push(cp as byte)
	} else if cp < 2048 {
		(mut b).push((192 + cp / 64) as byte)
		(mut b).push((128 + cp % 64) as byte)
	} else if cp < 65536 {
		(mut b).push((224 + cp / 4096) as byte)
		(mut b).push((128 + cp / 64 % 64) as byte)
		(mut b).push((128 + cp % 64) as byte)
	} else {
		(mut b).push((240 + cp / 262144) as byte)
		(mut b).push((128 + cp / 4096 % 64) as byte)
		(mut b).push((128 + cp / 64 % 64) as byte)
		(mut b).push((128 + cp % 64) as byte)
	}
}

/// The text from code point `from` to `to`, as a `str`.
pub fn slice(d: Dialog, from: int, to: int) -> str {
	var b = List[byte]()
	var i = from

	while i < to && i < d.text.len {
		push_utf8(mut b, d.text[i])

		i += 1
	}

	str_from_utf8(b) else ""
}

/// The whole text.
pub fn text_of(d: Dialog) -> str {
	slice(d, 0, d.text.len)
}

/// The title or question.
pub fn title_of(d: Dialog) -> str {
	str_from_utf8(d.title) else ""
}





